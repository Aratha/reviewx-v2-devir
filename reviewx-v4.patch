+                  <th scope="col">Nesneler</th>
+                  <th scope="col">Kural grupları</th>
+                  <th scope="col">Periyot</th>
+                  <th scope="col">Durum</th>
+                  <th scope="col">Sonraki çalışma</th>
+                  <th scope="col">Son sonuç</th>
+                  <th scope="col">İşlemler</th>
+                </tr>
+              </thead>
+              <tbody>
