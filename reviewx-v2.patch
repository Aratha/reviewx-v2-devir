+async def test_members_come_from_logins_and_a_new_group_empties_the_team(
+    auth: AuthHarness, admin: dict[str, str], recorded_logs: RecordingHandler
+) -> None:
+    team = (await auth.client.post(f"{auth.prefix}/teams", json=_body(), headers=admin)).json()
+    upn, password, _ = auth.directory.add(f"uye{uuid4().hex[:6]}", member_of=(DN,))
+    assert (await auth.login(upn.split("@")[0], password)).status_code == 200
+
+    members = (
+        await auth.client.get(f"{auth.prefix}/teams/{team['id']}/members", headers=admin)
+    ).json()
+    assert [item["username"] for item in members["items"]] == [upn]
+    read = (await auth.client.get(f"{auth.prefix}/teams/{team['id']}", headers=admin)).json()
+    assert read["member_count"] == 1
+    adding = await auth.client.post(
+        f"{auth.prefix}/teams/{team['id']}/members", json={"username": upn}, headers=admin
+    )
+    assert adding.status_code == 405
+
+    remapped = await auth.client.put(
+        f"{auth.prefix}/teams/{team['id']}",
+        json=_body(name="Yeni Ad", ad_group_dn="CN=Raporlama,DC=corp"),
+        headers=admin,
+    )
+    assert remapped.status_code == 200, remapped.text
+    assert remapped.json()["member_count"] == 0
+    assert [change[0] for change in await _changes(team["id"])] == [
+        "created",
+        "name",
+        "ad_group_dn",
+    ]
+    logged = " ".join(str(record.__dict__) for record in recorded_logs.records)
+    assert "DWH-Gelistirme" not in logged and "Raporlama" not in logged
+    assert recorded_logs.events("team.updated")
