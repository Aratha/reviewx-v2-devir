+"""Team management through HTTP and PostgreSQL.
+
+application-foundation/PRDs/003-team-scoping Requirement 1, 2, 6, 7 and Decision 1, 4, 5
+(Acceptance 2): only the super admin manages teams; names and AD group DNs are validated and
+unique regardless of case; members come from directory logins and their list is read-only; every
+name and group change is recorded; a bound team cannot be deleted; no DN reaches a log line.
+"""
+
+from collections.abc import AsyncIterator
+from typing import Any
+from uuid import uuid4
+
+import pytest
+from sqlalchemy import text
+
+from app.db.session import engine
+from tests.integration.conftest import (
+    AuthHarness,
+    RecordingHandler,
+    RoleSessions,
+    SuperAdmin,
+)
+
+pytestmark = pytest.mark.integration
+
+DN = "CN=DWH-Gelistirme,OU=Gruplar,DC=corp,DC=example,DC=test"
+
+
+@pytest.fixture
+async def admin(auth: AuthHarness, super_admin: SuperAdmin) -> AsyncIterator[dict[str, str]]:
+    response = await auth.login(super_admin.username, super_admin.password)
+    assert response.status_code == 200, response.text
+    try:
+        yield auth.auth_headers(response.json())
+    finally:
+        async with engine.begin() as connection:
+            await connection.execute(text("UPDATE scheduled_review SET team_id = NULL"))
+            await connection.execute(text("DELETE FROM app_team"))
+            await connection.execute(text("DELETE FROM app_team_change"))
+
+
+def _body(**overrides: Any) -> dict[str, Any]:
+    body: dict[str, Any] = {
+        "name": f"DWH Geliştirme {uuid4().hex[:4]}",
+        "description": "Veri ambarı geliştirme ekibi",
+        "ad_group_dn": DN,
+    }
+    body.update(overrides)
+    return body
+
+
+async def _changes(team_id: str) -> list[tuple[str, str | None, str | None]]:
+    async with engine.connect() as connection:
+        rows = await connection.execute(
+            text(
+                "SELECT changed_field, old_value, new_value FROM app_team_change "
+                "WHERE team_public_id = :id ORDER BY app_team_change_id"
+            ),
+            {"id": team_id},
+        )
+        return [tuple(row) for row in rows.all()]  # type: ignore[misc]
+
+
+async def test_only_the_super_admin_manages_teams(
+    auth: AuthHarness, role_sessions: RoleSessions, admin: dict[str, str]
+) -> None:
+    created = await auth.client.post(f"{auth.prefix}/teams", json=_body(), headers=admin)
+    assert created.status_code == 201, created.text
+    team_id = created.json()["id"]
+    for session in (await role_sessions.reviewer(), await role_sessions.rule_manager()):
+        for method, path, body in (
+            ("GET", "/teams", None),
+            ("POST", "/teams", _body()),
+            ("GET", f"/teams/{team_id}", None),
+            ("PUT", f"/teams/{team_id}", _body()),
+            ("DELETE", f"/teams/{team_id}", None),
+            ("GET", f"/teams/{team_id}/members", None),
+        ):
+            response = await auth.client.request(
+                method, f"{auth.prefix}{path}", json=body, headers=session.headers
+            )
+            assert response.status_code == 403, (method, path, response.status_code)
