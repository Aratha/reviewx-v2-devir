{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dwhcodereview Helm değerleri",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "frontend"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "existingSecret",
        "config",
        "persistence",
        "terminationGracePeriodSeconds",
        "networkPolicy",
        "service",
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "existingSecret": {
          "$ref": "#/definitions/kubernetesName"
        },
        "config": {
          "$ref": "#/definitions/backendConfig"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "accessMode",
            "size",
            "storageClass"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod",
                "ReadWriteMany"
              ]
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
            },
            "storageClass": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingress",
            "egress"
          ],
          "properties": {
            "ingress": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/ingressRule"
              }
            },
            "egress": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/egressRule"
              }
            }
          }
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "ingress",
        "networkPolicy",
        "service",
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "className",
            "host",
            "tlsSecretName"
          ],
          "properties": {
            "className": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)+$"
            },
            "tlsSecretName": {
              "$ref": "#/definitions/kubernetesName"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingress",
            "egress"
          ],
          "properties": {
            "ingress": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/ingressRule"
              }
            },
            "egress": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/egressRule"
              }
            }
          }
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "kubernetesName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "backendConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "MSSQL_SERVER": {"type": "string"},
        "MSSQL_PORT": {"type": "string"},
        "MSSQL_USER": {"type": "string"},
        "MSSQL_TRUSTED_CONNECTION": {"type": "string"},
        "MSSQL_ENCRYPT": {"type": "string"},
        "MSSQL_TRUST_SERVER_CERTIFICATE": {"type": "string"},
        "LLM_BASE_URL": {"type": "string"},
        "LLM_CHAT_API": {"type": "string", "enum": ["openai", "api_v1_chat"]},
        "LLM_CHAT_URL": {"type": "string"},
        "LLM_MODEL": {"type": "string"},
        "SQL_REVIEW_LLM_MODEL": {"type": "string"},
        "LLM_HTTP_TRUST_ENV": {"type": "string"},
        "LLM_HTTP_USER_AGENT": {"type": "string"},
        "LLM_ENFORCE_PRIVATE_NETWORK": {"type": "string"},
        "LLM_ALLOW_PUBLIC_HOSTS": {"type": "string"},
        "LLM_LOG_FULL_PAYLOADS": {"type": "string"},
        "SQL_REVIEW_MAX_CONCURRENT_RULES": {"type": "string"},
        "LLM_READ_TIMEOUT_SECONDS": {"type": "string"},
        "LLM_REQUEST_RETRIES": {"type": "string"},
        "SQL_REVIEW_TWO_PART_THRESHOLD_CHARS": {"type": "string"},
        "CORS_ORIGINS": {"type": "string"},
        "API_RATE_LIMIT_ENABLED": {"type": "string"},
        "API_RATE_LIMIT_WINDOW_SECONDS": {"type": "string"},
        "API_RATE_LIMIT_REVIEW_MAX": {"type": "string"}
      }
    },
    "ingressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "ports"
      ],
      "properties": {
        "from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/networkPeer"
          }
        },
        "ports": {
          "$ref": "#/definitions/networkPorts"
        }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "ports"
      ],
      "properties": {
        "to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/networkPeer"
          }
        },
        "ports": {
          "$ref": "#/definitions/networkPorts"
        }
      }
    },
    "networkPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": {
          "$ref": "#/definitions/labelSelector"
        },
        "podSelector": {
          "$ref": "#/definitions/labelSelector"
        },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "$ref": "#/definitions/cidr"
            },
            "except": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/cidr"
              }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "ipBlock",
              "namespaceSelector"
            ]
          },
          {
            "required": [
              "ipBlock",
              "podSelector"
            ]
          }
        ]
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchLabels"
      ],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cidr": {
      "type": "string",
      "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])|[0-9a-fA-F:]+/[0-9]{1,3})$",
      "not": {
        "enum": [
          "0.0.0.0/0",
          "::/0"
        ]
      }
    },
    "networkPorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "port"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP",
              "SCTP"
            ]
          },
          "port": {
            "$ref": "#/definitions/port"
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceQuantities"
        },
        "limits": {
          "$ref": "#/definitions/resourceQuantities"
        }
      }
    },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
