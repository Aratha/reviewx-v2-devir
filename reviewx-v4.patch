 DWHCODEREVIEW_REVIEW_HISTORY_RETENTION_DAYS=90
 
+# Scheduled reviews and their summary e-mail. The scheduler runs inside the backend and stays off
+# unless enabled. Without SMTP host or sender reports are still stored and the e-mail is recorded
+# as not configured. Only verified TLS is used; an empty CA bundle uses the system trust store.
+DWHCODEREVIEW_SCHEDULER_ENABLED=false
+DWHCODEREVIEW_SCHEDULER_TICK_SECONDS=60
+DWHCODEREVIEW_SMTP_HOST=
+DWHCODEREVIEW_SMTP_PORT=587
+DWHCODEREVIEW_SMTP_SECURITY=starttls
+DWHCODEREVIEW_SMTP_USERNAME=
+# DWHCODEREVIEW_SMTP_PASSWORD is a secret: export it in the shell for a host run; never write it
+# into this file or version control.
+DWHCODEREVIEW_SMTP_SENDER=
+DWHCODEREVIEW_SMTP_CA_BUNDLE=
+DWHCODEREVIEW_SMTP_TIMEOUT_SECONDS=30
+# Comma-separated corporate e-mail domains recipients may use; empty refuses every recipient.
+DWHCODEREVIEW_MAIL_ALLOWED_DOMAINS=
+
 # OpenTelemetry traces and metrics over OTLP/gRPC. Empty disables export; the observability Compose
 # overlay sets the collector address for the Compose backend. Outside the development environment
 # the address must be https. OTEL_* process variables stop startup.
