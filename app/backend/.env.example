# dwhcodereview backend development settings. Copy to .env; never commit .env.
# "development" is the local environment; every other value behaves as nonprod.
DWHCODEREVIEW_ENVIRONMENT=development
DWHCODEREVIEW_DEBUG=true
DWHCODEREVIEW_LOG_LEVEL=INFO
DWHCODEREVIEW_PROJECT_NAME=dwhcodereview

DWHCODEREVIEW_API_PREFIX=/api/dwhcodereview/v1
DWHCODEREVIEW_TENANT_HEADER=x-tenant-id
DWHCODEREVIEW_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
# Exact browser origin; session refresh and logout reject any other Origin header.
DWHCODEREVIEW_PUBLIC_ORIGIN=http://localhost:8080
# Ingress controller addresses or networks whose X-Forwarded-For header is trusted.
DWHCODEREVIEW_TRUSTED_PROXY_CIDRS=

# Required. Point it at a PostgreSQL you can reach from this machine and replace the placeholder
# password; this file is Git-ignored once copied to .env.
DWHCODEREVIEW_DATABASE_URL=postgresql+asyncpg://app:replace-with-a-local-password@localhost:5432/dwhcodereview_db

# DWHCODEREVIEW_JWT_PRIVATE_KEY holds the PEM signing key and never enters this file. For a host run,
# export the disposable local key from the project root:
#   export DWHCODEREVIEW_JWT_PRIVATE_KEY="$(sh scripts/dev-secrets.sh jwt-private-key)"
# Deployed environments receive their own key only through backend.existingSecret, which the
# project's helm deploy hook prepares in the cluster.
DWHCODEREVIEW_JWT_ALGORITHM=ES256
DWHCODEREVIEW_JWT_ISSUER=dwhcodereview
DWHCODEREVIEW_JWT_AUDIENCE=dwhcodereview-api
DWHCODEREVIEW_ACCESS_TOKEN_EXPIRE_MINUTES=15
DWHCODEREVIEW_REFRESH_SESSION_IDLE_MINUTES=60
DWHCODEREVIEW_REFRESH_SESSION_ABSOLUTE_HOURS=8
# Nonprod always limits local password login to the super admin; true adds the limit locally.
DWHCODEREVIEW_LOCAL_LOGIN_SUPER_ADMIN_ONLY_ENFORCED=false

# Login-only Active Directory over LDAPS. Disabled locally; scripts/create-local-user.sh creates
# local test accounts instead. When enabled, host, base DN, UPN suffix and CA bundle are required.
DWHCODEREVIEW_DIRECTORY_ENABLED=false
DWHCODEREVIEW_DIRECTORY_HOST=
DWHCODEREVIEW_DIRECTORY_PORT=636
DWHCODEREVIEW_DIRECTORY_BASE_DN=
DWHCODEREVIEW_DIRECTORY_UPN_SUFFIX=
DWHCODEREVIEW_DIRECTORY_CA_BUNDLE_PATH=
DWHCODEREVIEW_DIRECTORY_TLS_LEGACY_COMPATIBILITY=false
DWHCODEREVIEW_DIRECTORY_CONNECT_TIMEOUT_SECONDS=5
DWHCODEREVIEW_DIRECTORY_READ_TIMEOUT_SECONDS=10

# Read-only SQL Server catalog connection.
DWHCODEREVIEW_MSSQL_SERVER=
DWHCODEREVIEW_MSSQL_PORT=1433
DWHCODEREVIEW_MSSQL_USER=
# DWHCODEREVIEW_MSSQL_PASSWORD is a secret: export it in the shell for a host run; never write it
# into this file or version control.
DWHCODEREVIEW_MSSQL_ENCRYPT=true
DWHCODEREVIEW_MSSQL_TRUST_SERVER_CERTIFICATE=false
DWHCODEREVIEW_MSSQL_ALLOWED_DATABASES=
DWHCODEREVIEW_MSSQL_LOGIN_TIMEOUT_SECONDS=15
DWHCODEREVIEW_MSSQL_QUERY_TIMEOUT_SECONDS=60
DWHCODEREVIEW_MSSQL_MAX_CONCURRENCY=4

# Approved internal LLM endpoint.
DWHCODEREVIEW_LLM_CHAT_API=api_v1_chat
DWHCODEREVIEW_LLM_BASE_URL=
DWHCODEREVIEW_LLM_CHAT_URL=
DWHCODEREVIEW_LLM_MODEL=
# DWHCODEREVIEW_LLM_API_KEY is a secret and stays empty for an endpoint that needs no key; export
# it in the shell when one is required, never write it here.
DWHCODEREVIEW_LLM_CA_BUNDLE=
DWHCODEREVIEW_LLM_READ_TIMEOUT_SECONDS=900
DWHCODEREVIEW_LLM_REQUEST_RETRIES=2
DWHCODEREVIEW_LLM_MAX_CONCURRENT_CALLS=6
DWHCODEREVIEW_LLM_PROCESS_MAX_CONCURRENT_CALLS=12
DWHCODEREVIEW_LLM_USER_AGENT="DWHCodeReview-Backend/1.0 (internal SQL review; httpx)"

# Review runs.
DWHCODEREVIEW_REVIEW_MAX_SQL_CHARS=120000
DWHCODEREVIEW_REVIEW_TWO_PART_THRESHOLD_CHARS=45000
DWHCODEREVIEW_REVIEW_RATE_LIMIT_WINDOW_SECONDS=60
DWHCODEREVIEW_REVIEW_RATE_LIMIT_MAX_REQUESTS=30
DWHCODEREVIEW_REVIEW_HISTORY_RETENTION_DAYS=90

# OpenTelemetry traces and metrics over OTLP/gRPC. Empty disables export; the observability Compose
# overlay sets the collector address for the Compose backend. Outside the development environment
# the address must be https. OTEL_* process variables stop startup.
DWHCODEREVIEW_OTEL_EXPORTER_OTLP_ENDPOINT=
DWHCODEREVIEW_OTEL_SERVICE_NAME=dwhcodereview-backend
DWHCODEREVIEW_OTEL_TRACES_SAMPLE_RATIO=1.0
DWHCODEREVIEW_OTEL_METRIC_EXPORT_INTERVAL_SECONDS=60

DWHCODEREVIEW_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
DWHCODEREVIEW_BOOTSTRAP_SUPER_ADMIN_USERNAME=super-admin
# Supply DWHCODEREVIEW_BOOTSTRAP_SUPER_ADMIN_PASSWORD only in the command process environment.
# Do not add the password to this file or version control.
