+        await self.session.flush()
+        log_event(
+            logger,
+            "rule_publish_request.rejected",
+            request_public_id=request.public_id,
+            user_public_id=actor.public_id,
+        )
+        return await self._request_detail(tenant, actor, request_id, context)
