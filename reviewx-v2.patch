+"""Team rules that need no persistence.
+
+application-foundation/PRDs/003-team-scoping Requirement 1, 2, 4, 5 and Decision 3, 6
+(Acceptance 1): team name and AD group DN validation, matching the user's own memberOf values to
+team DNs regardless of letter case and spacing, and the scope decisions for rule groups and
+scheduled review definitions.
+"""
+
+import pytest
+
+from app.domain.team import (
+    TEAM_AD_GROUP_DN_MAX_LENGTH,
+    TEAM_NAME_MAX_LENGTH,
+    TeamValidationError,
+    can_select_rule_group,
+    dn_key,
+    matching_teams,
+    normalize_ad_group_dn,
+    normalize_team_name,
+    schedule_access,
+)
+
+pytestmark = pytest.mark.unit
+
+DWH = "CN=DWH-Gelistirme,OU=Gruplar,DC=corp,DC=example,DC=test"
+RAPOR = "CN=Raporlama,OU=Gruplar,DC=corp,DC=example,DC=test"
+
+
+def test_a_team_name_is_trimmed_and_limited_to_80_characters() -> None:
+    assert normalize_team_name("  DWH Geliştirme ") == "DWH Geliştirme"
+    assert normalize_team_name("a" * TEAM_NAME_MAX_LENGTH) == "a" * 80
+    for bad in ("", "   ", "a" * 81, "satır\nkırılımı"):
+        with pytest.raises(TeamValidationError) as error:
+            normalize_team_name(bad)
+        assert error.value.code == "team_name_invalid"
+
+
+def test_a_group_dn_is_normalized_around_separators() -> None:
+    assert normalize_ad_group_dn("  cn = DWH-Gelistirme , OU=Gruplar,DC=corp ") == (
+        "cn=DWH-Gelistirme,OU=Gruplar,DC=corp"
+    )
+    # An escaped comma belongs to the value.
+    assert normalize_ad_group_dn(r"CN=Ekip\, DWH,OU=Gruplar") == r"CN=Ekip\, DWH,OU=Gruplar"
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "DWH-Gelistirme",
+        "OU=Gruplar,DC=corp",
+        "CN=,OU=Gruplar",
+        "CN=DWH,,OU=Gruplar",
+        "CN=DWH,OU",
+        "CN=DWH,=x",
+        "CN=DWH\nOU=x",
+        "CN=" + "a" * TEAM_AD_GROUP_DN_MAX_LENGTH,
+    ],
+)
+def test_a_group_dn_must_be_a_cn_dn_of_at_most_512_characters(value: str) -> None:
+    with pytest.raises(TeamValidationError) as error:
+        normalize_ad_group_dn(value)
+    assert error.value.code == "team_ad_group_invalid"
+
+
+def test_dn_keys_ignore_letter_case_and_spacing() -> None:
+    assert dn_key("CN=DWH-Gelistirme, OU=Gruplar") == dn_key("cn=dwh-gelistirme,ou=GRUPLAR")
+    assert dn_key(DWH) != dn_key(RAPOR)
+
+
+def test_member_of_values_match_teams_by_their_dn() -> None:
+    teams = {dn_key(DWH): 1, dn_key(RAPOR): 2}
+    assert matching_teams([DWH.upper()], teams) == {1}
+    assert matching_teams([DWH, RAPOR, "CN=Baska,DC=corp"], teams) == {1, 2}
+    assert matching_teams(["CN=Baska,DC=corp"], teams) == set()
+    assert matching_teams([], teams) == set()
+    assert matching_teams([DWH], {}) == set()
+
+
+def test_a_team_group_is_selectable_only_by_members_and_an_open_one_by_everyone() -> None:
+    assert can_select_rule_group(None, frozenset())
+    assert can_select_rule_group(None, frozenset({3}))
+    assert can_select_rule_group(3, frozenset({3, 4}))
+    assert not can_select_rule_group(3, frozenset({4}))
+    assert not can_select_rule_group(3, frozenset())
+
+
+@pytest.mark.parametrize(
+    ("owner", "team", "super_admin", "teams", "expected"),
+    [
+        (True, None, False, frozenset(), "manage"),
+        (False, None, False, frozenset({1}), None),
+        (False, 1, False, frozenset({1}), "read"),
+        (False, 1, False, frozenset({2}), None),
+        (True, 1, False, frozenset(), "manage"),
+        (False, 1, True, frozenset(), "manage"),
+        (False, None, True, frozenset(), "manage"),
+    ],
+)
+def test_schedule_access_follows_ownership_team_and_super_admin(
+    owner: bool, team: int | None, super_admin: bool, teams: frozenset[int], expected: str | None
+) -> None:
+    assert (
+        schedule_access(
+            is_owner=owner, team_id=team, is_super_admin=super_admin, user_team_ids=teams
+        )
+        == expected
+    )
