+    owner = await role_sessions.reviewer()
+    async with engine.begin() as connection:
+        await connection.execute(
+            text(
+                "INSERT INTO scheduled_review (public_id, tenant_id, owner_user_id, name, "
+                "selection_mode, selection, frequency, run_hour, run_minute, timezone, "
+                "recipients, team_id) SELECT :id, t.tenant_id, u.user_id, 'Ekip taraması', "
+                "'filter', CAST(:selection AS jsonb), 'daily', 7, 0, 'Europe/Istanbul', "
+                "CAST(:recipients AS jsonb), t.team_id FROM app_team t, app_user u "
+                "WHERE t.public_id = :team AND u.public_id = :owner"
+            ),
+            {
+                "id": str(uuid4()),
+                "selection": '{"mode": "filter", "database": "DWH"}',
+                "recipients": '["a@kurum.example"]',
+                "team": team["id"],
+                "owner": owner.public_id,
+            },
+        )
+    refused = await auth.client.delete(f"{auth.prefix}/teams/{team['id']}", headers=admin)
+    assert refused.status_code == 409
+    assert refused.json()["detail"]["code"] == "team_in_use"
+    assert "1 zamanlanmış inceleme" in refused.json()["detail"]["message"]
+
+    async with engine.begin() as connection:
