diff --git a/app/frontend/src/components/rules/RuleGroupManager.tsx b/app/frontend/src/components/rules/RuleGroupManager.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..93b24ef0f856ef0e7cf86cc57380da1c638cff73
--- /dev/null
+++ b/app/frontend/src/components/rules/RuleGroupManager.tsx
@@ -0,0 +1,105 @@
+import {useId} from 'react';
+import {Button} from '@/components/ui/Button';
+import {withCurrentTeam} from '@/hooks/useTeamOptions';
+import {RULE_GROUP_NAME_LIMIT, RULE_GROUPS_LIMIT} from '@/lib/rules';
+import type {RuleGroupItem, TeamRef} from '@/types/sqlReview';
+
+/**
+ * The named rule groups of the draft (sql-review rule-group-selection Requirement 1, 8): add,
+ * rename and remove; each group shows how many rules it holds. Removing a group leaves its rules
+ * ungrouped; the page owns that change. A group may belong to a team, whose members alone select it
+ * for a run (application-foundation team-scoping Requirement 4, 8).
+ */
+export function RuleGroupManager({
+  groups,
+  counts,
+  problem,
+  disabled,
+  teamOptions,
+  onRename,
+  onTeam,
+  onRemove,
+  onAdd,
+}: {
+  groups: RuleGroupItem[];
+  counts: Map<string, number>;
+  problem: string | null;
+  disabled: boolean;
+  teamOptions: TeamRef[];
+  onRename: (id: string, name: string) => void;
+  onTeam: (id: string, teamId: string | null) => void;
+  onRemove: (id: string) => void;
+  onAdd: () => void;
+}) {
+  const headingId = useId();
+  const problemId = useId();
+  return (
+    <section className="card" aria-labelledby={headingId}>
+      <header className="card-header">
+        <h2 id={headingId}>
+          Kural grupları <span className="subtle">({groups.length})</span>
+        </h2>
+      </header>
+      <div className="card-body stack">
+        <p className="muted">
+          İnceleyiciler incelemeyi bu gruplardan biri veya birkaçıyla başlatabilir. Her kural en çok bir gruba
+          atanır; grup atanmayan kural yalnız “Tüm kurallar” incelemesinde çalışır. Bir ekibe ait grubu
+          koşumda yalnız o ekibin üyeleri seçebilir.
+        </p>
+        {groups.length === 0 && <p className="muted">Henüz kural grubu yok.</p>}
+        <ol className="list stack-tight">
+          {groups.map((group, index) => (
+            <li key={group.id} className="row">
+              <input
+                className="input grow"
+                aria-label={`Kural grubu ${index + 1} adı`}
+                aria-invalid={problem !== null || undefined}
+                aria-describedby={problem ? problemId : undefined}
+                value={group.name}
+                maxLength={RULE_GROUP_NAME_LIMIT * 2}
+                disabled={disabled}
+                onChange={(event) => onRename(group.id, event.target.value)}
+              />
+              <select
+                className="select"
+                aria-label={`${group.name.trim() || `Kural grubu ${index + 1}`} ekibi`}
+                value={group.team_id ?? ''}
+                disabled={disabled}
+                onChange={(event) => onTeam(group.id, event.target.value || null)}
+              >
+                <option value="">Herkese açık</option>
+                {withCurrentTeam(teamOptions, group.team_id, group.team_name).map((team) => (
+                  <option key={team.id} value={team.id}>
+                    Ekip: {team.name}
+                  </option>
+                ))}
+              </select>
+              <span className="subtle nowrap tabular">{counts.get(group.id) ?? 0} kural</span>
+              <Button
+                size="sm"
+                variant="danger-outline"
+                aria-label={`${group.name.trim() || `Kural grubu ${index + 1}`} grubunu sil`}
+                disabled={disabled}
+                onClick={() => onRemove(group.id)}
+              >
+                Sil
+              </Button>
+            </li>
+          ))}
+        </ol>
+        {problem && (
+          <p id={problemId} className="field-error" role="alert">
+            {problem}
+          </p>
+        )}
+        <Button
+          onClick={onAdd}
+          disabled={disabled || groups.length >= RULE_GROUPS_LIMIT}
+          aria-label="Kural grubu ekle"
+        >
+          + Grup
+        </Button>
+      </div>
+    </section>
+  );
+}
