@@ -0,0 +1,87 @@
+"""Team management for the super admin (application-foundation 003-team-scoping API contract).
+
+Every endpoint needs the super admin (Decision 1); other roles get 403. Memberships come only
+from the directory, so the member list is read-only and there is no endpoint to add a member.
+"""
+
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Path, Response, status
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.auth.dependencies import CurrentContext, require_super_admin
+from app.api.validation import envelope_validation_route
+from app.db.session import get_db
+from app.schemas.teams.contracts import TeamItem, TeamList, TeamMemberList, TeamWrite
+from app.services.team_service import TeamService
+
+router = APIRouter(
+    prefix="/teams",
+    tags=["teams"],
+    route_class=envelope_validation_route(status.HTTP_422_UNPROCESSABLE_CONTENT),
+    dependencies=[Depends(require_super_admin())],
+    responses={401: {"description": "Oturum yok"}, 403: {"description": "Yalnız süper yönetici"}},
+)
+
+_NOT_FOUND: dict[int | str, dict[str, object]] = {404: {"description": "team_not_found"}}
+_INVALID: dict[int | str, dict[str, object]] = {
+    422: {
+        "description": (
+            "team_name_invalid, team_name_duplicate, team_ad_group_invalid veya "
+            "team_ad_group_duplicate"
+        )
+    }
+}
+
+
+def get_team_service(session: Annotated[AsyncSession, Depends(get_db)]) -> TeamService:
+    return TeamService(session)
+
+
+Service = Annotated[TeamService, Depends(get_team_service)]
+TeamId = Annotated[str, Path(min_length=1, max_length=64)]
+
+
+@router.get("", response_model=TeamList)
+async def list_teams(context: CurrentContext, service: Service) -> TeamList:
+    """Teams of the tenant with the number of members matched at their last login."""
+
+    return await service.list_teams(context)
+
+
+@router.post("", response_model=TeamItem, status_code=status.HTTP_201_CREATED, responses=_INVALID)
+async def create_team(body: TeamWrite, context: CurrentContext, service: Service) -> TeamItem:
+    return await service.create(context, body)
+
+
+@router.get("/{team_id}", response_model=TeamItem, responses=_NOT_FOUND)
+async def read_team(team_id: TeamId, context: CurrentContext, service: Service) -> TeamItem:
+    return await service.detail(context, team_id)
+
+
+@router.put("/{team_id}", response_model=TeamItem, responses={**_NOT_FOUND, **_INVALID})
+async def update_team(
+    team_id: TeamId, body: TeamWrite, context: CurrentContext, service: Service
+) -> TeamItem:
+    """Rename or remap a team; a new AD group empties it until its members log in again."""
+
+    return await service.update(context, team_id, body)
+
+
+@router.delete(
+    "/{team_id}",
+    status_code=status.HTTP_204_NO_CONTENT,
+    responses={**_NOT_FOUND, 409: {"description": "team_in_use: bağlı grup veya tanım var"}},
+)
+async def delete_team(team_id: TeamId, context: CurrentContext, service: Service) -> Response:
+    await service.delete(context, team_id)
+    return Response(status_code=status.HTTP_204_NO_CONTENT)
+
+
+@router.get("/{team_id}/members", response_model=TeamMemberList, responses=_NOT_FOUND)
+async def list_team_members(
+    team_id: TeamId, context: CurrentContext, service: Service
+) -> TeamMemberList:
+    """Read-only: membership comes from the Active Directory group."""
+
+    return await service.members(context, team_id)
