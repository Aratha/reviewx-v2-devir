+++ b/app/backend/app/domain/team.py
@@ -0,0 +1,118 @@
+"""Team rules that need no persistence (application-foundation/PRDs/003-team-scoping).
+
+A team is a user set of one tenant mapped to one Active Directory group DN (Decision 4). Every
+directory login matches the user's own ``memberOf`` values to team DNs, ignoring letter case and
+the spacing around separators; nested groups are not resolved. The scope decisions here are the
+single place that says who may select a team's rule group (Requirement 4) and who may read or
+manage a team's scheduled review (Requirement 5, Decision 3, 6). DNs and names are never logged.
+"""
+
+import re
+import unicodedata
+from collections.abc import Iterable, Mapping
+from typing import Literal
+
+TEAM_NAME_MAX_LENGTH = 80
+TEAM_DESCRIPTION_MAX_LENGTH = 500
+TEAM_AD_GROUP_DN_MAX_LENGTH = 512
+
+# One "attribute=value" component: an attribute name, then a value that may hold escaped commas.
+_RDN = re.compile(r"^([A-Za-z][A-Za-z0-9-]*)\s*=\s*(.+)$", re.DOTALL)
+_UNESCAPED_COMMA = re.compile(r"(?<!\\),")
+
+ScheduleAccess = Literal["manage", "read"]
+
+
+class TeamValidationError(Exception):
+    """A rejected team; the code and Turkish message form the 422 error envelope."""
+
+    def __init__(self, code: str, message: str) -> None:
+        super().__init__(code)
+        self.code = code
+        self.message = message
+
+
+def _has_control(value: str) -> bool:
+    return any(unicodedata.category(char) == "Cc" for char in value)
+
+
+def normalize_team_name(name: str) -> str:
+    value = name.strip()
+    if not 1 <= len(value) <= TEAM_NAME_MAX_LENGTH or _has_control(value):
+        raise TeamValidationError(
+            "team_name_invalid", f"Ekip adı 1-{TEAM_NAME_MAX_LENGTH} karakter olmalıdır."
+        )
+    return value
+
+
+def normalize_ad_group_dn(value: str) -> str:
+    """The DN with the spaces around separators removed; it must start with a CN component.
+
+    The application never searches the directory, so the group's existence is not checked
+    (Requirement 1); only the form is.
+    """
+
+    invalid = TeamValidationError(
+        "team_ad_group_invalid",
+        "AD grup adı CN= ile başlayan geçerli bir ayırt edici ad (DN) olmalıdır.",
+    )
+    text = value.strip()
+    if not text or len(text) > TEAM_AD_GROUP_DN_MAX_LENGTH or _has_control(text):
+        raise invalid
+    components = []
+    for part in _UNESCAPED_COMMA.split(text):
+        match = _RDN.fullmatch(part.strip())
+        if match is None or not match.group(2).strip():
+            raise invalid
+        components.append(f"{match.group(1)}={match.group(2).strip()}")
+    if components[0].split("=", 1)[0].casefold() != "cn":
+        raise invalid
+    normalized = ",".join(components)
+    if len(normalized) > TEAM_AD_GROUP_DN_MAX_LENGTH:
+        raise invalid
+    return normalized
+
+
+def dn_key(value: str) -> str:
+    """The comparison key of a DN: separator spacing removed, letters case-folded."""
+
+    try:
+        return normalize_ad_group_dn(value).casefold()
+    except TeamValidationError:
+        return value.strip().casefold()
+
+
+def matching_teams(member_of: Iterable[str], team_ids_by_dn_key: Mapping[str, int]) -> set[int]:
+    """Teams whose AD group is one of the user's direct groups (Requirement 2)."""
+
+    return {
