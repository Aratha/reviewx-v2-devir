@@ -0,0 +1,88 @@
+"""Revision 202610050003: teams, memberships, team history and team bindings.
+
+application-foundation/PRDs/003-team-scoping "Veri ve geçiş" against the migrated database: the
+step goes down and up again, and it refuses to go down while a team or a binding is stored, so
+team data is never dropped silently.
+"""
+
+import asyncio
+from pathlib import Path
+from typing import Any
+from uuid import uuid4
+
+import pytest
+from alembic import command
+from alembic.config import Config
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import create_async_engine
+
+from app.core.config import get_settings
+
+pytestmark = pytest.mark.integration
+
+_BEFORE_TEAMS = "202610050002"
+_TEAM_TABLES = ("app_team", "app_team_member", "app_team_change")
+
+
+async def _run(statement: str, **params: Any) -> list[Any]:
+    probe = create_async_engine(get_settings().database_url)
+    try:
+        async with probe.begin() as connection:
+            result = await connection.execute(text(statement), params)
+            return list(result.all()) if result.returns_rows else []
+    finally:
+        await probe.dispose()
+
+
+def _tables() -> set[str]:
+    rows = asyncio.run(
+        _run(
+            "SELECT tablename FROM pg_tables WHERE schemaname = 'public' "
+            "AND tablename = ANY(:names)",
+            names=list(_TEAM_TABLES),
+        )
+    )
+    return {str(row[0]) for row in rows}
+
+
+def clear_team_data() -> None:
+    """Remove every stored team row and binding on the disposable test database.
+
+    Other integration tests create teams and bind groups and definitions to them; a migration
+    test that walks below 202610050003 clears them first, since the downgrade refuses them.
+    """
+
+    for statement in (
+        "UPDATE rule_set_draft_group SET team_id = NULL WHERE team_id IS NOT NULL",
+        "UPDATE rule_set_version_group SET team_id = NULL WHERE team_id IS NOT NULL",
+        "UPDATE scheduled_review SET team_id = NULL WHERE team_id IS NOT NULL",
+        "DELETE FROM app_team_change",
+        "DELETE FROM app_team",
+    ):
+        asyncio.run(_run(statement))
+
+
+def test_the_team_migration_goes_down_and_up_again(migrated_database: None) -> None:
+    config = Config(str(Path(__file__).resolve().parents[2] / "alembic.ini"))
+    try:
+        assert _tables() == set(_TEAM_TABLES)
+        asyncio.run(
+            _run(
+                "INSERT INTO app_team (public_id, tenant_id, name, ad_group_dn) SELECT :id, "
+                "tenant_id, 'DWH Geliştirme', 'CN=DWH,OU=Gruplar,DC=corp' FROM tenant "
+                "WHERE code = 'platform'",
+                id=str(uuid4()),
+            )
+        )
+
+        with pytest.raises(RuntimeError, match="team data is stored"):
+            command.downgrade(config, _BEFORE_TEAMS)
+        assert _tables() == set(_TEAM_TABLES)
+
+        clear_team_data()
+        command.downgrade(config, _BEFORE_TEAMS)
+        assert _tables() == set()
+    finally:
+        command.upgrade(config, "head")
+    assert _tables() == set(_TEAM_TABLES)
+    command.check(config)
