+        with pytest.raises(IntegrityError):
+            async with connection.begin_nested():
+                await connection.execute(
+                    text("DELETE FROM app_team WHERE team_id = :t"), {"t": team}
+                )
+
+        await connection.execute(text("DELETE FROM app_user WHERE user_id = :u"), {"u": member})
+        assert (
+            await _scalar(
+                connection, "SELECT count(*) FROM app_team_member WHERE team_id = :t", t=team
+            )
+            == 1
+        )
+        await connection.execute(
+            text("DELETE FROM scheduled_review WHERE scheduled_review_id = :d"), {"d": definition}
+        )
+        await connection.execute(text("DELETE FROM app_team WHERE team_id = :t"), {"t": team})
+        assert (
+            await _scalar(
+                connection, "SELECT count(*) FROM app_team_member WHERE team_id = :t", t=team
+            )
+            == 0
+        )
+        await connection.rollback()
