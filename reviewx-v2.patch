+    assert account.member_of == (TEAM_DN, OTHER_DN)
+    assert [name for name, _ in connection.calls] == ["open", "bind", "search", "unbind"]
+    # Group names never reach a log line through the account's repr.
+    assert TEAM_DN not in repr(account)
+
+
+async def test_a_record_without_member_of_has_no_groups() -> None:
+    account = await _client(FakeConnection(entries=[_raw(guid=uuid4())]), []).authenticate(
+        UPN, "parola"
+    )
+    assert account.member_of == ()
+
+
+@pytest.mark.parametrize(
+    "member_of",
+    [
+        {"memberOf;range=0-1499": [TEAM_DN.encode()]},
+        {"memberOf": [bytes([0xFF, 0xFE])]},
+    ],
+)
+async def test_a_partial_or_unreadable_member_of_is_unknown_and_login_still_succeeds(
+    member_of: dict[str, list[bytes]],
+) -> None:
+    raw = _raw(guid=uuid4())
+    raw.update(member_of)
+
+    account = await _client(FakeConnection(entries=[raw]), []).authenticate(UPN, "parola")
+
+    assert account.member_of is None
+    assert account.enabled and account.is_human
