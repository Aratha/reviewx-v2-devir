diff --git a/app/frontend/src/hooks/useTeamOptions.ts b/app/frontend/src/hooks/useTeamOptions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b8037d5ae46538732a4d98b13fa2804bba23c756
--- /dev/null
+++ b/app/frontend/src/hooks/useTeamOptions.ts
@@ -0,0 +1,22 @@
+import {useAuth} from '@/contexts/AuthContext';
+import {useResource} from '@/hooks/useResource';
+import {TeamService} from '@/services/teams';
+import type {TeamRef} from '@/types/sqlReview';
+
+/**
+ * Teams a form may bind to (application-foundation team-scoping Requirement 8). The super admin
+ * manages teams and chooses among all of them; everyone else chooses among the teams they belong
+ * to (from the session), because the team list itself is the super admin's.
+ */
+export function useTeamOptions(): TeamRef[] {
+  const {user, access} = useAuth();
+  const all = useResource(access.administerUsers ? 'team-options' : null, (signal) => TeamService.list(signal));
+  if (access.administerUsers) return (all.data?.items ?? []).map((team) => ({id: team.id, name: team.name}));
+  return user?.teams ?? [];
+}
+
+/** The options plus the currently bound team, so an existing binding is never silently lost. */
+export function withCurrentTeam(options: TeamRef[], id: string | null | undefined, name: string | null | undefined): TeamRef[] {
+  if (!id || options.some((team) => team.id === id)) return options;
+  return [...options, {id, name: name ?? 'Erişiminiz olmayan ekip'}];
+}
