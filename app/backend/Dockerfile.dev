# Build from the scaffold root: docker build -f app/backend/Dockerfile.dev .
ARG PYTHON_BASE_IMAGE=python:3.13-alpine3.23@sha256:7ea3f82de8ea6d4fb7e5d2bbe3fe3c9d931700b7a529f1fe5769e42abe514ca1

FROM ${PYTHON_BASE_IMAGE}

ARG APP_GID=10001
ARG APP_UID=10001
ARG DEPENDENCY_MODE=connected
ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/workspace/app/backend

RUN addgroup -g "${APP_GID}" app \
    && adduser -D -H -u "${APP_UID}" -G app app

WORKDIR /workspace/app/backend

# unixODBC, the Microsoft ODBC driver and the organization root CA; every package is digest-locked
# in app/infra/locks and apk installs without network access.
COPY app/infra/locks/backend-alpine-packages.lock app/infra/locks/msodbcsql18-alpine-packages.lock /tmp/system-locks/
COPY app/infra/install-backend-system-packages.sh /tmp/system-locks/install.sh
COPY app/backend/certs/corporate-inference-root.crt /tmp/system-locks/corporate-inference-root.crt
RUN --mount=type=bind,from=system_packages,source=/,target=/opt/system-packages \
    sh /tmp/system-locks/install.sh "${DEPENDENCY_MODE}" "${TARGETARCH}" /tmp/system-locks \
        /opt/system-packages /tmp/system-locks/corporate-inference-root.crt \
    && rm -rf /tmp/system-locks

COPY app/backend/requirements.txt app/backend/requirements-dev.txt /tmp/dependencies/
RUN --mount=type=bind,from=python_wheelhouse,source=/,target=/opt/wheelhouse \
    --mount=type=secret,id=pip_conf,target=/etc/pip.conf,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) \
            python -m pip install --no-cache-dir \
                -r /tmp/dependencies/requirements.txt \
                -r /tmp/dependencies/requirements-dev.txt \
            ;; \
        offline) \
            PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 \
                python -m pip install --no-cache-dir --no-index \
                --find-links=/opt/wheelhouse \
                -r /tmp/dependencies/requirements.txt \
                -r /tmp/dependencies/requirements-dev.txt \
            ;; \
        *) \
            echo "DEPENDENCY_MODE must be connected or offline" >&2; \
            exit 64 \
            ;; \
    esac; \
    rm -rf /tmp/dependencies

COPY --chmod=0755 app/backend/entrypoint.dev.sh /usr/local/bin/backend-entrypoint

USER ${APP_UID}:${APP_GID}
EXPOSE 8000
ENTRYPOINT ["backend-entrypoint"]
