diff --git a/e2e/sql-review/04-rule-groups.mjs b/e2e/sql-review/04-rule-groups.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..efce89c48dfff6fe9c72ecd5e87efe8746ed367e
--- /dev/null
+++ b/e2e/sql-review/04-rule-groups.mjs
@@ -0,0 +1,212 @@
+import {withBrowser, baseUrl, accounts, message, signIn, apiStatus} from '../shared/harness.mjs';
+
+/**
+ * rule-group-selection Acceptance 4 (local): the rule manager defines two named groups, assigns a
+ * new rule to each and publishes; the reviewer sees the groups on the published-rules page and on
+ * the script review page, runs a review with one group and gets only that group's rules, each
+ * labelled with the group name; a run with no group selected runs every rule. Like
+ * 02-script-review-history, `APP_E2E_LLM_BASE_URL` names the LLM endpoint; without it only the
+ * rule-side steps and the "not configured" refusal are checked. The scenario removes its rules and
+ * groups, publishes the original content again, restores the LLM settings and deletes its runs in
+ * `finally`.
+ */
+const llmBaseUrl = process.env.APP_E2E_LLM_BASE_URL || '';
+const llmModel = process.env.APP_E2E_LLM_MODEL || 'e2e-model';
+const STAMP = Date.now();
+const GROUP_A = `E2E Güvenlik ${STAMP}`;
+const GROUP_B = `E2E Performans ${STAMP}`;
+const RULE_A = `E2E grup kuralı A ${STAMP}: NOLOCK kullanılmamalıdır.`;
+const RULE_B = `E2E grup kuralı B ${STAMP}: SELECT * kullanılmamalıdır.`;
+const LABEL_GROUP = `e2e-grup-${STAMP}`;
+const LABEL_ALL = `e2e-tum-${STAMP}`;
+const SQL = ['CREATE PROCEDURE dbo.e2e_group AS', 'BEGIN', '  SELECT *', '  FROM #kaynak WITH (NOLOCK);', 'END'].join('\n');
+
+function formatRuleId(value) {
+  return value < 100 ? `Kural${String(value).padStart(2, '0')}` : `Kural${value}`;
+}
+
+async function openScriptPage(page) {
+  await page.getByRole('navigation', {name: message('shell.navigation')}).getByRole('link', {name: 'SQL betiği incelemesi'}).click();
+  await page.getByRole('heading', {name: 'SQL betiği incelemesi', level: 1}).waitFor();
+}
+
+async function addGroup(page, index, name) {
+  await page.getByRole('button', {name: 'Kural grubu ekle'}).click();
+  await page.getByLabel(`Kural grubu ${index} adı`).fill(name);
+}
+
+async function addRule(page, ruleId, text, groupName) {
+  await page.getByRole('button', {name: 'Normal grubuna kural ekle'}).click();
+  await page.getByLabel(`${ruleId} kural metni`).fill(text);
+  await page.getByLabel(`${ruleId} kural grubu`).selectOption({label: groupName});
+}
+
+async function finishedRun(page, label) {
+  const runs = (await apiStatus(page, '/review-runs?scope=mine&page_size=200')).body.items;
+  const run = runs.find((item) => item.title === label);
+  if (!run) throw new Error(`run ${label} was not stored`);
+  return (await apiStatus(page, `/review-runs/${run.id}`)).body;
+}
+
+function ruleIdsOf(detail) {
+  return detail.results.flatMap((result) => result.rule_results.map((rule) => rule.rule_id));
+}
+
+await withBrowser('rule groups: define, publish, review with one group and with every rule', async ({page, assert, newPage}) => {
+  const manager = page;
+  await signIn(manager, accounts.ruleManager);
+  const previousLlm = (await apiStatus(manager, '/llm-connection')).body;
+  const reviewer = await newPage();
+  await signIn(reviewer, accounts.reviewer);
+  let changed = false;
+  try {
+    // Rule manager: two groups, one new rule in each, save and publish.
+    await manager.getByRole('navigation', {name: message('shell.navigation')}).getByRole('link', {name: 'Kurallar', exact: true}).click();
+    await manager.getByRole('heading', {name: 'Kurallar', level: 1}).waitFor();
+    const before = await apiStatus(manager, '/rule-set');
+    assert.equal(before.status, 200);
+    const previousVersion = before.body.latest_version.number;
+    const groupCount = before.body.groups.length;
+    await addGroup(manager, groupCount + 1, GROUP_A);
+    await addGroup(manager, groupCount + 2, GROUP_B);
+    const ruleA = before.body.next_rule_id;
+    await addRule(manager, ruleA, RULE_A, GROUP_A);
+    // The page numbers new rules one after another from next_rule_id.
+    const ruleB = formatRuleId(Number(ruleA.replace('Kural', '')) + 1);
+    await addRule(manager, ruleB, RULE_B, GROUP_B);
+    await manager.getByRole('button', {name: 'Taslağı kaydet'}).click();
+    await manager.getByText('Taslak kaydedildi.').waitFor();
+    changed = true;
+    await manager.getByRole('button', {name: 'Yayınla'}).click();
+    await manager.getByText(`Sürüm ${previousVersion + 1} yayımlandı.`, {exact: false}).waitFor();
+
+    const published = (await apiStatus(manager, '/rule-set/versions/latest')).body;
+    const groupA = published.groups.find((group) => group.name === GROUP_A);
+    const groupB = published.groups.find((group) => group.name === GROUP_B);
+    assert.ok(groupA && groupB, 'both groups are frozen in the new version');
+    const allRuleIds = [...published.critical, ...published.normal].map((rule) => rule.id);
+    const groupARuleIds = [...published.critical, ...published.normal]
+      .filter((rule) => rule.rule_group_id === groupA.id)
+      .map((rule) => rule.id);
+    assert.deepEqual(groupARuleIds, [ruleA]);
+
+    // Reviewer: the groups are listed on the published-rules page and offered on the review page.
+    const nav = reviewer.getByRole('navigation', {name: message('shell.navigation')});
+    await nav.getByRole('link', {name: 'Yayımlanmış kurallar'}).click();
+    const groupsCard = reviewer.getByRole('region', {name: 'Kural grupları'});
+    await groupsCard.getByText(GROUP_A).waitFor();
+    await groupsCard.getByText(GROUP_B).waitFor();
+
+    await openScriptPage(reviewer);
+    await reviewer.getByText('Hiçbir grup seçilmezse tüm kurallar çalışır.').waitFor();
+    await reviewer.getByLabel(`${GROUP_A} (1 kural)`).waitFor();
+    await reviewer.getByLabel(`${GROUP_B} (1 kural)`).waitFor();
+
+    if (!llmBaseUrl) {
+      await reviewer.getByLabel(`${GROUP_A} (1 kural)`).check();
+      await reviewer.getByLabel('SQL').fill(SQL);
+      await reviewer.getByRole('button', {name: 'Kurallara göre incele'}).click();
+      const live = reviewer.getByRole('dialog', {name: 'Canlı inceleme'});
+      await live.getByRole('alert').filter({hasText: 'LLM bağlantısı yapılandırılmamış.'}).waitFor();
+      console.log('NOTE APP_E2E_LLM_BASE_URL not set: verified groups and the not-configured refusal only');
+      return;
+    }
+
+    await manager.goto(baseUrl + '/ayarlar/llm');
+    await manager.getByLabel('İstek biçimi').selectOption('openai');
+    await manager.getByLabel('Temel adres').fill(llmBaseUrl);
+    await manager.getByLabel('Sohbet adresi (isteğe bağlı)').fill('');
+    await manager.getByLabel('Model').fill(llmModel);
+    await manager.getByRole('button', {name: 'Kaydet'}).click();
+    await manager.getByText('LLM bağlantı ayarları kaydedildi.').waitFor();
+
+    // A group the published version does not have is refused before any LLM call.
+    const unknown = await apiStatus(reviewer, '/script-reviews', {
+      method: 'POST',
+      body: {sql: SQL, rule_group_ids: ['e2e-olmayan-grup']},
+    });
+    assert.equal(unknown.status, 422);
+    assert.equal(unknown.body.detail.code, 'rule_group_unknown');
+
+    // One group: only its rule runs, and the result names the group.
+    await reviewer.getByLabel(`${GROUP_A} (1 kural)`).check();
+    await reviewer.getByLabel('Sonuçlarda görünecek ad (isteğe bağlı)').fill(LABEL_GROUP);
+    await reviewer.getByLabel('SQL').fill(SQL);
+    await reviewer.getByRole('button', {name: 'Kurallara göre incele'}).click();
+    let live = reviewer.getByRole('dialog', {name: 'Canlı inceleme'});
+    await live.getByText('İnceleme tamamlandı.').waitFor({timeout: 900_000});
+    await live.getByRole('button', {name: 'Sonuçları göster'}).click();
+    let results = reviewer.getByRole('dialog', {name: 'İnceleme sonuçları'});
+    await results.getByRole('list', {name: `Grup: ${GROUP_A}`}).first().waitFor();
+    assert.equal(await results.getByRole('heading', {name: /^Grupsuz kurallar/}).count(), 0);
+    await results.getByRole('button', {name: 'Kapat'}).click();
+
+    const grouped = await finishedRun(reviewer, LABEL_GROUP);
+    assert.equal(grouped.all_rules, false);
+    assert.deepEqual(grouped.selected_rule_groups, [{id: groupA.id, name: GROUP_A}]);
+    assert.deepEqual(ruleIdsOf(grouped), [ruleA]);
+    assert.ok(grouped.results.every((result) => result.rule_results.every((rule) => rule.rule_group_name === GROUP_A)));
+
+    // The history detail and the CSV carry the selection as well.
+    await nav.getByRole('link', {name: 'İnceleme geçmişi'}).click();
+    await reviewer.getByRole('button', {name: new RegExp(`^${LABEL_GROUP} — Tamamlandı`)}).click();
+    await reviewer.getByText(`Kural grupları: ${GROUP_A}`).waitFor();
+    const csv = await apiStatus(reviewer, `/review-runs/${grouped.id}/exports/csv`);
+    assert.equal(csv.status, 200);
+
+    // No group selected: every rule of the version runs and the run says so.
+    await openScriptPage(reviewer);
+    await reviewer.getByLabel(`${GROUP_A} (1 kural)`).waitFor();
+    assert.equal(await reviewer.getByLabel(`${GROUP_A} (1 kural)`).isChecked(), false);
+    await reviewer.getByLabel('Sonuçlarda görünecek ad (isteğe bağlı)').fill(LABEL_ALL);
+    await reviewer.getByLabel('SQL').fill(SQL);
+    await reviewer.getByRole('button', {name: 'Kurallara göre incele'}).click();
+    live = reviewer.getByRole('dialog', {name: 'Canlı inceleme'});
+    await live.getByText('İnceleme tamamlandı.').waitFor({timeout: 900_000});
+    await live.getByRole('button', {name: 'Kapat'}).click();
+    const everything = await finishedRun(reviewer, LABEL_ALL);
+    assert.equal(everything.all_rules, true);
+    assert.deepEqual(everything.selected_rule_groups, []);
+    assert.deepEqual([...ruleIdsOf(everything)].sort(), [...allRuleIds].sort());
+  } finally {
+    const runs = await apiStatus(reviewer, '/review-runs?scope=mine&page_size=200');
+    for (const item of runs.body?.items ?? []) {
+      if ([LABEL_GROUP, LABEL_ALL].includes(item.title)) await apiStatus(reviewer, `/review-runs/${item.id}`, {method: 'DELETE'});
+    }
+    if (changed) {
+      // Remove the scenario's rules and groups and publish the original content again.
+      const current = await apiStatus(manager, '/rule-set');
+      const ours = new Set(current.body.groups.filter((group) => [GROUP_A, GROUP_B].includes(group.name)).map((group) => group.id));
+      const keep = (rule) => ![RULE_A, RULE_B].includes(rule.text);
+      const saved = await apiStatus(manager, '/rule-set/draft', {
+        method: 'PUT',
+        body: {
+          base_revision: current.body.revision,
+          critical: current.body.critical.filter(keep),
+          normal: current.body.normal.filter(keep),
+          groups: current.body.groups.filter((group) => !ours.has(group.id)),
+        },
+      });
+      assert.equal(saved.status, 200);
+      const republished = await apiStatus(manager, '/rule-set/versions', {
+        method: 'POST',
+        body: {base_revision: saved.body.revision},
+      });
+      assert.ok([200, 201].includes(republished.status));
+    }
+    if (llmBaseUrl && previousLlm.editable) {
+      const restored = await apiStatus(manager, '/llm-connection', {
+        method: 'PUT',
+        body: {
+          chat_api: previousLlm.chat_api,
+          base_url: previousLlm.base_url ?? '',
+          chat_url: previousLlm.chat_url ?? '',
+          model: previousLlm.model,
+        },
+      });
+      assert.equal(restored.status, 200);
+    }
+  }
+}, {
+  expectedServerErrors: llmBaseUrl ? [] : [/^503 POST .*\/api\/dwhcodereview\/v1\/script-reviews$/],
+});
diff --git a/e2e/sql-review/05-scheduled-review.mjs b/e2e/sql-review/05-scheduled-review.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..63135f6af7a5f2e2870c66e4862532363cdf2124
--- /dev/null
+++ b/e2e/sql-review/05-scheduled-review.mjs
@@ -0,0 +1,132 @@
+import {withBrowser, baseUrl, accounts, message, signIn, apiStatus} from '../shared/harness.mjs';
+
+/**
+ * scheduled-review-email Acceptance 4 and review-history-export Acceptance 6 (local L2). The
+ * reviewer defines a scheduled review on the page, pauses and resumes it; the super admin runs it
+ * now and the backend scheduler (DWHCODEREVIEW_SCHEDULER_ENABLED=true) runs it in the background.
+ * With `APP_E2E_LLM_BASE_URL` and `APP_E2E_SQL_OBJECT` ("DATABASE.schema.name:TYPE", an object of
+ * the test SQL Server) the run completes: the report is stored, the owner opens it through the
+ * e-mail link, a user who was not a recipient of that run gets 404, and after the second reviewer
+ * is added as a recipient the next run opens for them read-only. The summary e-mail state is
+ * "sent" with a test relay and "not configured" without one; its content (no code snippet) is
+ * checked in the relay's mailbox, outside this script. Without those variables the run is
+ * expected to end with a stable error code instead. The backend must allow the local accounts'
+ * e-mail domain in DWHCODEREVIEW_MAIL_ALLOWED_DOMAINS. The definition and its runs are deleted in
+ * `finally`.
+ */
+const llmBaseUrl = process.env.APP_E2E_LLM_BASE_URL || '';
+const objectSpec = process.env.APP_E2E_SQL_OBJECT || '';
+const NAME = `e2e-zamanli-${Date.now()}`;
+const FINISHED = new Set(['completed', 'failed', 'cancelled', 'interrupted', 'skipped']);
+
+function selection() {
+  const match = /^([^.]+)\.([^.]+)\.([^:]+):([A-Z]{1,2})$/.exec(objectSpec);
+  if (!match) return {mode: 'filter', filter: {database: 'DWH'}};
+  const [, database, schema, name, typeCode] = match;
+  return {mode: 'list', items: [{database, schema, name, type_code: typeCode}]};
+}
+
+async function emailOf(admin, account) {
+  const users = await apiStatus(admin, '/admin/users?page=1&size=200');
+  const user = users.body.items.find((item) => item.username === account.username);
+  if (!user) throw new Error(`account ${account.username} is not listed`);
+  return user.email;
+}
+
+/** The scheduler ticks once a minute; a real model answers each rule in turn. */
+async function finishedRun(page, scheduleId, previous, assert) {
+  const deadline = Date.now() + 900_000;
+  while (Date.now() < deadline) {
+    const runs = await apiStatus(page, `/scheduled-reviews/${scheduleId}/runs`);
+    assert.equal(runs.status, 200);
+    const fresh = runs.body.items.filter((item) => !previous.includes(item.id));
+    const done = fresh.find((item) => FINISHED.has(item.state));
+    if (done) return done;
+    await page.waitForTimeout(5_000);
+  }
+  throw new Error('the scheduled run did not finish in time');
+}
+
+await withBrowser('scheduled review: define, run in the background, open the report from the e-mail link', async ({page, assert, newPage}) => {
+  const admin = page;
+  await signIn(admin, accounts.superAdmin);
+  const owner = await newPage();
+  await signIn(owner, accounts.reviewer);
+  const other = await newPage();
+  await signIn(other, accounts.secondReviewer);
+  const ownerEmail = await emailOf(admin, accounts.reviewer);
+  const otherEmail = await emailOf(admin, accounts.secondReviewer);
+  let scheduleId = null;
+  const runIds = [];
+  try {
+    const body = {
+      name: NAME,
+      selection: selection(),
+      rule_group_ids: [],
+      period: {frequency: 'daily', hour: 3, minute: 0, timezone: 'Europe/Istanbul'},
+      recipients: [ownerEmail],
+    };
+    const created = await apiStatus(owner, '/scheduled-reviews', {method: 'POST', body});
+    assert.equal(created.status, 201, `create answered ${created.status} ${created.body?.detail?.code ?? ''}`);
+    scheduleId = created.body.id;
+
+    // The page lists the definition with its period; pause and resume change its state.
+    await owner.getByRole('navigation', {name: message('shell.navigation')}).getByRole('link', {name: 'Zamanlanmış incelemeler'}).click();
+    await owner.getByRole('heading', {name: 'Zamanlanmış incelemeler', level: 1}).waitFor();
+    const row = owner.getByRole('row').filter({hasText: NAME});
+    await row.getByText('Her gün 03:00 (Europe/Istanbul)').waitFor();
+    await owner.getByRole('button', {name: `${NAME} tanımını duraklat`}).click();
+    await owner.getByText('Tanım duraklatıldı.').waitFor();
+    await row.getByText('Duraklatıldı').waitFor();
+    await owner.getByRole('button', {name: `${NAME} tanımını etkinleştir`}).click();
+    await owner.getByText('Tanım etkinleştirildi.').waitFor();
+    assert.equal(await owner.getByRole('button', {name: `${NAME} şimdi çalıştır`}).count(), 0);
+    assert.equal((await apiStatus(other, `/scheduled-reviews/${scheduleId}`)).status, 404);
+
+    // The super admin sees every definition and runs this one now.
+    await admin.goto(baseUrl + '/zamanlanmis-incelemeler');
+    await admin.getByRole('button', {name: `${NAME} şimdi çalıştır`}).click();
+    await admin.getByText('Koşum sıraya alındı.').waitFor();
+    const first = await finishedRun(owner, scheduleId, [], assert);
+
+    if (!llmBaseUrl || !objectSpec) {
+      assert.equal(first.state, 'failed');
+      assert.equal(first.trigger, 'manual');
+      console.log('NOTE APP_E2E_LLM_BASE_URL or APP_E2E_SQL_OBJECT not set: verified definition, pause, run now and a failed background run only');
+      return;
+    }
+
+    assert.equal(first.state, 'completed');
+    assert.ok(['sent', 'not_configured'].includes(first.email_status), first.email_status);
+    runIds.push(first.review_run_id);
+    // The e-mail link opens the report for the owner; the second reviewer was no recipient.
+    await owner.goto(`${baseUrl}/gecmis?run=${first.review_run_id}`);
+    await owner.getByText('Zamanlanmış', {exact: true}).first().waitFor();
+    assert.equal((await apiStatus(other, `/review-runs/${first.review_run_id}`)).status, 404);
+
+    // Adding a recipient affects the next run only (review-history-export Decision 8).
+    const updated = await apiStatus(owner, `/scheduled-reviews/${scheduleId}`, {
+      method: 'PUT',
+      body: {...body, recipients: [ownerEmail, otherEmail]},
+    });
+    assert.equal(updated.status, 200);
+    const queued = await apiStatus(admin, `/scheduled-reviews/${scheduleId}/run`, {method: 'POST'});
+    assert.equal(queued.status, 202);
+    const second = await finishedRun(owner, scheduleId, [first.id], assert);
+    assert.equal(second.state, 'completed');
+    runIds.push(second.review_run_id);
+
+    await other.goto(`${baseUrl}/gecmis?run=${second.review_run_id}`);
+    await other.getByText('Bu inceleme başka bir kullanıcıya ait; yalnız okunabilir.').waitFor();
+    assert.equal(await other.getByRole('checkbox', {name: /yanlış pozitif/}).count(), 0);
+    assert.equal((await apiStatus(other, `/review-runs/${second.review_run_id}/exports/csv`)).status, 200);
+    assert.equal((await apiStatus(other, `/review-runs/${second.review_run_id}`, {method: 'DELETE'})).status, 404);
+    assert.equal((await apiStatus(other, `/review-runs/${first.review_run_id}`)).status, 404);
+  } finally {
+    for (const runId of runIds) await apiStatus(owner, `/review-runs/${runId}`, {method: 'DELETE'});
+    if (scheduleId) {
+      const removed = await apiStatus(owner, `/scheduled-reviews/${scheduleId}`, {method: 'DELETE'});
+      assert.ok([204, 404].includes(removed.status), `delete answered ${removed.status}`);
+    }
+  }
+});
