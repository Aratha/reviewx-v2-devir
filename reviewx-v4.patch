+      </td>
+      <td>{periodLabel(item.period)}</td>
+      <td>
+        <Badge tone={item.status === 'active' ? 'success' : 'neutral'}>
+          {item.status === 'active' ? 'Etkin' : 'Duraklatıldı'}
+        </Badge>
