diff --git a/app/backend/app/services/team_service.py b/app/backend/app/services/team_service.py
new file mode 100644
index 0000000000000000000000000000000000000000..40ed160c8c1da59cb41168fe7c006a5492f1edc7
--- /dev/null
+++ b/app/backend/app/services/team_service.py
@@ -0,0 +1,232 @@
+"""Team management by the super admin (application-foundation/PRDs/003-team-scoping).
+
+Requirement 1, 6, 7 and Decision 1, 5: teams are created, renamed, remapped and deleted only by
+the super admin; a team bound to a rule group or a scheduled review cannot be deleted. Every name
+and AD group change is written to the append-only team history in the same transaction. A changed
+AD group drops the team's memberships, which the members' next directory login rebuilds. Names
+and DNs never reach a log line.
+"""
+
+import logging
+
+from fastapi import status
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.errors import ApplicationError
+from app.core.logging import log_event
+from app.core.request_context import RequestContext
+from app.domain.models.team import Team, TeamChange, TeamChangeField
+from app.domain.models.tenant import Tenant
+from app.domain.models.user import User
+from app.domain.scheduled_review import fold_name
+from app.domain.team import (
+    TEAM_DESCRIPTION_MAX_LENGTH,
+    TeamValidationError,
+    dn_key,
+    normalize_ad_group_dn,
+    normalize_team_name,
+)
+from app.infrastructure.repositories.team_repository import TeamRepository
+from app.infrastructure.repositories.user_repository import UserRepository
+from app.schemas.teams.contracts import (
+    TeamItem,
+    TeamList,
+    TeamMemberItem,
+    TeamMemberList,
+    TeamWrite,
+)
+from app.services.request_scope import acting_user, active_tenant
+
+logger = logging.getLogger("app.admin")
+
+
+def _not_found() -> ApplicationError:
+    return ApplicationError(status.HTTP_404_NOT_FOUND, "team_not_found", "Ekip bulunamadı.")
+
+
+def _unprocessable(code: str, message: str) -> ApplicationError:
+    return ApplicationError(status.HTTP_422_UNPROCESSABLE_CONTENT, code, message)
+
+
+def _item(team: Team, member_count: int) -> TeamItem:
+    return TeamItem(
+        id=team.public_id,
+        name=team.name,
+        description=team.description,
+        ad_group_dn=team.ad_group_dn,
+        member_count=member_count,
+    )
+
+
+class TeamService:
+    def __init__(self, session: AsyncSession) -> None:
+        self.session = session
+        self.teams = TeamRepository(session)
+        self.users = UserRepository(session)
+
+    async def _scope(self, context: RequestContext) -> tuple[Tenant, User]:
+        return await active_tenant(self.users, context), await acting_user(self.users, context)
+
+    async def _team(
+        self, context: RequestContext, public_id: str, *, lock: bool = False
+    ) -> tuple[Tenant, User, Team]:
+        tenant, actor = await self._scope(context)
+        team = await self.teams.get_team(tenant.tenant_id, public_id, lock=lock)
+        if team is None:
+            raise _not_found()
+        return tenant, actor, team
+
+    async def list_teams(self, context: RequestContext) -> TeamList:
+        tenant, _ = await self._scope(context)
+        teams = await self.teams.list_teams(tenant.tenant_id)
+        counts = await self.teams.member_counts([team.team_id for team in teams])
+        return TeamList(
+            items=[_item(team, counts.get(team.team_id, 0)) for team in teams], total=len(teams)
+        )
+
+    async def detail(self, context: RequestContext, public_id: str) -> TeamItem:
+        _, _, team = await self._team(context, public_id)
+        counts = await self.teams.member_counts([team.team_id])
+        return _item(team, counts.get(team.team_id, 0))
+
+    async def members(self, context: RequestContext, public_id: str) -> TeamMemberList:
+        _, _, team = await self._team(context, public_id)
+        rows = await self.teams.members(team.team_id)
+        return TeamMemberList(
+            items=[
+                TeamMemberItem(
+                    display_name=row.display_name,
+                    username=row.username,
+                    synced_at=row.synced_at,
+                    last_login_at=row.last_login_at,
+                )
+                for row in rows
+            ],
+            total=len(rows),
+        )
+
+    async def _validated(
+        self, tenant_id: int, body: TeamWrite, *, except_id: int | None
+    ) -> tuple[str, str, str]:
+        try:
+            name = normalize_team_name(body.name)
+            dn = normalize_ad_group_dn(body.ad_group_dn)
+        except TeamValidationError as error:
+            raise _unprocessable(error.code, error.message) from None
+        description = body.description.strip()
+        if len(description) > TEAM_DESCRIPTION_MAX_LENGTH:
+            raise _unprocessable(
+                "team_name_invalid",
+                f"Ekip açıklaması en çok {TEAM_DESCRIPTION_MAX_LENGTH} karakter olabilir.",
+            )
+        others = [
+            team for team in await self.teams.list_teams(tenant_id) if team.team_id != except_id
+        ]
+        if any(fold_name(team.name) == fold_name(name) for team in others):
+            raise _unprocessable("team_name_duplicate", "Aynı adla ikinci bir ekip tanımlanamaz.")
+        if any(dn_key(team.ad_group_dn) == dn_key(dn) for team in others):
+            raise _unprocessable("team_ad_group_duplicate", "Bu AD grubu başka bir ekibe eşlenmiş.")
+        return name, description, dn
+
+    async def _flush(self) -> None:
+        try:
+            await self.session.flush()
+        except IntegrityError:
+            # A concurrent request saved the same ASCII-folded name or group first.
+            raise _unprocessable(
+                "team_name_duplicate", "Aynı ad veya AD grubu başka bir ekipte kullanılıyor."
+            ) from None
+
+    def _change(
+        self,
+        tenant: Tenant,
+        actor: User,
+        team: Team,
+        field: TeamChangeField,
+        old: str | None,
+        new: str | None,
+    ) -> TeamChange:
+        return TeamChange(
+            tenant_id=tenant.tenant_id,
+            actor_user_id=actor.user_id,
+            team_public_id=team.public_id,
+            changed_field=field.value,
+            old_value=old,
+            new_value=new,
+            created_by=actor.user_id,
+            updated_by=actor.user_id,
+        )
+
+    async def create(self, context: RequestContext, body: TeamWrite) -> TeamItem:
+        tenant, actor = await self._scope(context)
+        name, description, dn = await self._validated(tenant.tenant_id, body, except_id=None)
+        team = Team(
+            tenant_id=tenant.tenant_id,
+            name=name,
+            description=description,
+            ad_group_dn=dn,
+            created_by=actor.user_id,
+            updated_by=actor.user_id,
+        )
+        self.session.add(team)
+        await self._flush()
+        self.session.add(self._change(tenant, actor, team, TeamChangeField.CREATED, None, dn))
+        await self.session.flush()
+        log_event(
+            logger, "team.created", team_public_id=team.public_id, user_public_id=actor.public_id
+        )
+        return _item(team, 0)
+
+    async def update(self, context: RequestContext, public_id: str, body: TeamWrite) -> TeamItem:
+        tenant, actor, team = await self._team(context, public_id, lock=True)
+        name, description, dn = await self._validated(
+            tenant.tenant_id, body, except_id=team.team_id
+        )
+        if name != team.name:
+            self.session.add(
+                self._change(tenant, actor, team, TeamChangeField.NAME, team.name, name)
+            )
+            team.name = name
+        group_changed = dn_key(dn) != dn_key(team.ad_group_dn)
+        if dn != team.ad_group_dn:
+            self.session.add(
+                self._change(tenant, actor, team, TeamChangeField.AD_GROUP_DN, team.ad_group_dn, dn)
+            )
+            team.ad_group_dn = dn
+        team.description = description
+        team.updated_by = actor.user_id
+        if group_changed:
+            # Members of the old group are not members of the new one; their next directory
+            # login places them again.
+            await self.teams.clear_members(team.team_id)
+        await self._flush()
+        log_event(
+            logger,
+            "team.updated",
+            team_public_id=team.public_id,
+            user_public_id=actor.public_id,
+            group_changed=group_changed,
+        )
+        counts = await self.teams.member_counts([team.team_id])
+        return _item(team, counts.get(team.team_id, 0))
+
+    async def delete(self, context: RequestContext, public_id: str) -> None:
+        tenant, actor, team = await self._team(context, public_id, lock=True)
+        bindings = await self.teams.bindings(team)
+        if bindings.any:
+            raise ApplicationError(
+                status.HTTP_409_CONFLICT,
+                "team_in_use",
+                f"Bu ekibe bağlı {bindings.rule_groups} kural grubu ve "
+                f"{bindings.scheduled_reviews} zamanlanmış inceleme var; önce bunları başka ekibe "
+                "veya ekipsize taşıyın.",
+            )
+        self.session.add(
+            self._change(tenant, actor, team, TeamChangeField.DELETED, team.ad_group_dn, None)
+        )
+        await self.session.flush()
+        await self.teams.delete_team(team.team_id)
+        log_event(
+            logger, "team.deleted", team_public_id=team.public_id, user_public_id=actor.public_id
+        )
diff --git a/app/backend/tests/fakes/smtp_server.py b/app/backend/tests/fakes/smtp_server.py
new file mode 100644
index 0000000000000000000000000000000000000000..71ed025f6c3d68dcba31233d131a4739674baad2
--- /dev/null
+++ b/app/backend/tests/fakes/smtp_server.py
@@ -0,0 +1,120 @@
+"""A real-TCP fake SMTP server with STARTTLS (sql-review 008-scheduled-review-email tests).
+
+It speaks just enough SMTP for the adapter: EHLO, STARTTLS with the test CA of
+``tests.fakes.llm_server.write_pki``, AUTH PLAIN, MAIL, RCPT, DATA and QUIT. Each accepted
+message is recorded with its envelope; switches make it refuse a recipient, refuse the login or
+offer no STARTTLS so the adapter's failure classes can be observed.
+"""
+
+import asyncio
+import base64
+import ssl
+from dataclasses import dataclass, field
+
+from tests.fakes.llm_server import TestPki
+
+
+@dataclass
+class ReceivedMail:
+    sender: str
+    recipients: list[str]
+    data: bytes
+    tls: bool
+    login: str | None
+
+
+@dataclass
+class FakeSmtpServer:
+    pki: TestPki | None = None
+    offer_starttls: bool = True
+    reject_recipients: bool = False
+    accepted_login: tuple[str, str] | None = None
+    received: list[ReceivedMail] = field(default_factory=list)
+    connections: int = 0
+    _server: asyncio.Server | None = None
+
+    async def start(self) -> FakeSmtpServer:
+        self._server = await asyncio.start_server(self._handle, "127.0.0.1", 0)
+        return self
+
+    async def close(self) -> None:
+        if self._server is not None:
+            self._server.close()
+            await self._server.wait_closed()
+
+    @property
+    def port(self) -> int:
+        assert self._server is not None
+        return int(self._server.sockets[0].getsockname()[1])
+
+    async def _handle(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
+        self.connections += 1
+        tls = False
+        login: str | None = None
+        sender = ""
+        recipients: list[str] = []
+
+        async def reply(line: str) -> None:
+            writer.write(line.encode("ascii") + b"\r\n")
+            await writer.drain()
+
+        try:
+            await reply("220 fake.smtp ESMTP")
+            while True:
+                raw = await reader.readline()
+                if not raw:
+                    return
+                line = raw.decode("utf-8").rstrip("\r\n")
+                verb = line.split(" ", 1)[0].upper()
+                if verb in {"EHLO", "HELO"}:
+                    lines = ["fake.smtp"]
+                    if self.offer_starttls and not tls and self.pki is not None:
+                        lines.append("STARTTLS")
+                    if tls or self.pki is None:
+                        lines.append("AUTH PLAIN")
+                    for index, text in enumerate(lines):
+                        await reply(f"250{'-' if index < len(lines) - 1 else ' '}{text}")
+                elif verb == "STARTTLS" and self.pki is not None:
+                    await reply("220 ready for TLS")
+                    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+                    context.load_cert_chain(self.pki.certificate_path, self.pki.key_path)
+                    await writer.start_tls(context)
+                    tls = True
+                elif verb == "AUTH":
+                    encoded = line.split(" ", 2)[2]
+                    _, user, password = base64.b64decode(encoded).decode("utf-8").split("\0")
+                    if self.accepted_login == (user, password):
+                        login = user
+                        await reply("235 accepted")
+                    else:
+                        await reply("535 authentication failed")
+                elif verb == "MAIL":
+                    sender = line.split(":", 1)[1].strip().strip("<>").split(">")[0]
+                    await reply("250 ok")
+                elif verb == "RCPT":
+                    if self.reject_recipients:
+                        await reply("550 no such user")
+                    else:
+                        recipients.append(line.split(":", 1)[1].strip().strip("<>"))
+                        await reply("250 ok")
+                elif verb == "DATA":
+                    await reply("354 go ahead")
+                    data = bytearray()
+                    while (chunk := await reader.readline()) not in (b".\r\n", b""):
+                        data += chunk
+                    self.received.append(
+                        ReceivedMail(sender, list(recipients), bytes(data), tls, login)
+                    )
+                    await reply("250 queued")
+                elif verb == "RSET":
+                    recipients.clear()
+                    await reply("250 ok")
+                elif verb == "QUIT":
+                    await reply("221 bye")
+                    return
+                else:
+                    await reply("502 not implemented")
+        except ConnectionError, ssl.SSLError, asyncio.IncompleteReadError:
+            return
+        finally:
+            writer.close()
