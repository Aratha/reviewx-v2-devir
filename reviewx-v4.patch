+            public_id=new_public_id(),
+            kind=RuleProposalKind.GROUP.value,
+            group_name=valid.name,
+            group_description=valid.description,
+            rule_codes=list(valid.rule_codes),
+        )
+
+    async def list_proposals(
+        self,
+        context: RequestContext,
