+def can_select_rule_group[T](team_id: T | None, user_team_ids: frozenset[T]) -> bool:
+    """A group without a team is open to everyone; a team's group only to its members."""
+
+    return team_id is None or team_id in user_team_ids
+
+
+def schedule_access(
+    *,
+    is_owner: bool,
+    team_id: int | None,
+    is_super_admin: bool,
+    user_team_ids: frozenset[int],
+) -> ScheduleAccess | None:
+    """Who sees a scheduled review definition (Requirement 5, Decision 3, 6).
+
+    The owner and the super admin manage it; members of its team read it; anyone else does not
+    see it (404).
+    """
+
+    if is_owner or is_super_admin:
+        return "manage"
+    if team_id is not None and team_id in user_team_ids:
+        return "read"
+    return None
