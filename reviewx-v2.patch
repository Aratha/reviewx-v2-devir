+/**
+ * Rule results split by their named group in first-appearance order, ungrouped ones last
+ * (rule-group-selection Requirement 6). Without any group there is one unnamed section, so a run
+ * of an ungrouped version looks as before.
+ */
+function groupSections(rules: RuleResult[]): {title: string | undefined; rules: RuleResult[]}[] {
+  if (!rules.some((rule) => rule.rule_group_name)) return [{title: undefined, rules}];
+  const sections = new Map<string, RuleResult[]>();
+  const ungrouped: RuleResult[] = [];
+  for (const rule of rules) {
+    if (!rule.rule_group_name) ungrouped.push(rule);
+    else sections.set(rule.rule_group_name, [...(sections.get(rule.rule_group_name) ?? []), rule]);
+  }
+  return [
+    ...[...sections].map(([name, grouped]) => ({title: `Grup: ${name}`, rules: grouped})),
+    ...(ungrouped.length > 0 ? [{title: 'Grupsuz kurallar', rules: ungrouped}] : []),
