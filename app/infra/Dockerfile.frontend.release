ARG FRONTEND_NODE_BASE_IMAGE=registry.internal.invalid/platform/node:22.23.2-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6
ARG NGINX_BASE_IMAGE=registry.internal.invalid/platform/nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
FROM scratch AS npm_cache
FROM ${FRONTEND_NODE_BASE_IMAGE} AS build
ARG DEPENDENCY_MODE=offline
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /src
RUN chown node:node /src
USER node
COPY --chown=node:node app/frontend/package.json app/frontend/package-lock.json ./
RUN --mount=type=bind,from=npm_cache,source=/,target=/opt/npm-cache \
    --mount=type=secret,id=npmrc,target=/tmp/npmrc,mode=0444,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) NPM_CONFIG_USERCONFIG=/tmp/npmrc npm ci --ignore-scripts ;; \
        offline) NPM_CONFIG_USERCONFIG=/dev/null npm ci --offline --ignore-scripts \
            --cache /opt/npm-cache --logs-dir=/tmp/npm-logs ;; \
        *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
    esac
COPY --chown=node:node app/frontend/ ./
RUN npm run build

FROM ${NGINX_BASE_IMAGE}
COPY app/frontend/nginx.release.conf /etc/nginx/conf.d/default.conf
COPY app/frontend/nginx.security-headers.conf /etc/nginx/conf.d/security-headers.conf
COPY --from=build /src/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
