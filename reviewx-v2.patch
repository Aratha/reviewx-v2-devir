@@ -0,0 +1,298 @@
+import {useState} from 'react';
+import {Alert} from '@/components/ui/Alert';
+import {Badge} from '@/components/ui/Badge';
+import {Button} from '@/components/ui/Button';
+import {Card} from '@/components/ui/Card';
+import {ConfirmDialog} from '@/components/ui/ConfirmDialog';
+import {Dialog} from '@/components/ui/Dialog';
+import {Field} from '@/components/ui/Field';
+import {PageHeader} from '@/components/ui/PageHeader';
+import {EmptyState, ErrorState, LoadingState} from '@/components/ui/States';
+import {useResource} from '@/hooks/useResource';
+import {describeError} from '@/lib/errorMessages';
+import {formatDateTime} from '@/lib/format';
+import {TeamService} from '@/services/teams';
+import type {TeamItem} from '@/types/sqlReview';
+
+export const DN_NOTE =
+  'Uygulama dizinde arama yapmaz; DN Active Directory’de doğrulanmaz. Eşleşen üye sayısı sıfır kalırsa DN’yi kontrol edin.';
+export const MEMBERSHIP_NOTE =
+  'Üyelik Active Directory grubundan gelir ve kullanıcının bir sonraki girişinde güncellenir; buradan üye eklenmez.';
+
+const NAME_LIMIT = 80;
+const DN_LIMIT = 512;
+
+type Editing = {team: TeamItem | null};
+
+/**
+ * Teams for the super admin (application-foundation team-scoping Requirement 1, 6, 8): create,
+ * rename, remap to an Active Directory group and delete; the members of each team are read-only
+ * because they come from the directory.
+ */
+export default function TeamsPage() {
+  const teams = useResource('teams', (signal) => TeamService.list(signal));
+  const [editing, setEditing] = useState<Editing | null>(null);
+  const [membersOf, setMembersOf] = useState<TeamItem | null>(null);
+  const [pendingDelete, setPendingDelete] = useState<TeamItem | null>(null);
+  const [deleting, setDeleting] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [failure, setFailure] = useState<string | null>(null);
+
+  async function remove(team: TeamItem) {
+    setDeleting(true);
+    setNotice(null);
+    setFailure(null);
+    try {
+      await TeamService.remove(team.id);
+      setNotice('Ekip silindi.');
+      teams.reload();
+    } catch (error) {
+      setFailure(describeError(error));
+    } finally {
+      setDeleting(false);
+      setPendingDelete(null);
+    }
+  }
+
+  const data = teams.data;
+  return (
+    <div className="page">
+      <PageHeader
+        title="Ekipler"
+        description="Her ekip bir Active Directory grubuna eşlenir; kullanıcılar girişte grup üyeliklerine göre ekiplere düşer."
+        actions={
+          <Button variant="primary" onClick={() => setEditing({team: null})}>
+            Yeni ekip
+          </Button>
+        }
+      />
+      <Alert tone="info">{MEMBERSHIP_NOTE}</Alert>
+      {notice && <Alert tone="success">{notice}</Alert>}
+      {failure && <Alert tone="error">{failure}</Alert>}
+      {teams.status === 'error' && <ErrorState message={describeError(teams.error)} onRetry={teams.reload} />}
+      {teams.status === 'loading' && data === undefined && <LoadingState label="Ekipler yükleniyor…" />}
+      {data && (
+        <Card title={`Ekipler (${data.total})`} bodyClassName="table-wrap">
+          {data.items.length === 0 ? (
+            <EmptyState title="Henüz ekip yok. Ekip tanımlanmadıkça bütün kural grupları herkese açıktır." />
+          ) : (
+            <table className="table">
+              <thead>
+                <tr>
+                  <th scope="col">Ad</th>
+                  <th scope="col">AD grubu (DN)</th>
+                  <th scope="col">Eşleşen üye</th>
+                  <th scope="col">İşlemler</th>
+                </tr>
+              </thead>
+              <tbody>
+                {data.items.map((team) => (
+                  <tr key={team.id}>
+                    <td>
+                      <div className="stack-tight">
+                        <strong>{team.name}</strong>
+                        {team.description && <span className="subtle">{team.description}</span>}
+                      </div>
+                    </td>
+                    <td className="mono">{team.ad_group_dn}</td>
+                    <td>
+                      {team.member_count === 0 ? (
+                        <Badge tone="warning">Eşleşen üye yok</Badge>
+                      ) : (
+                        team.member_count
+                      )}
+                    </td>
+                    <td>
+                      <div className="row">
+                        <Button size="sm" onClick={() => setMembersOf(team)} aria-label={`${team.name} üyeleri`}>
+                          Üyeler
+                        </Button>
+                        <Button
+                          size="sm"
+                          onClick={() => setEditing({team})}
+                          aria-label={`${team.name} ekibini düzenle`}
+                        >
+                          Düzenle
+                        </Button>
+                        <Button
+                          size="sm"
+                          variant="danger-outline"
+                          onClick={() => setPendingDelete(team)}
+                          aria-label={`${team.name} ekibini sil`}
+                        >
+                          Sil
+                        </Button>
+                      </div>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          )}
+        </Card>
+      )}
+      {editing && (
+        <TeamDialog
+          team={editing.team}
+          onClose={() => setEditing(null)}
+          onSaved={(created) => {
+            setEditing(null);
+            setFailure(null);
+            setNotice(created ? 'Ekip oluşturuldu.' : 'Ekip kaydedildi.');
+            teams.reload();
+          }}
+        />
+      )}
+      {membersOf && <MembersDialog team={membersOf} onClose={() => setMembersOf(null)} />}
+      {pendingDelete && (
+        <ConfirmDialog
+          title="Ekip silinsin mi?"
+          confirmLabel="Sil"
+          danger
+          busy={deleting}
+          onCancel={() => setPendingDelete(null)}
+          onConfirm={() => remove(pendingDelete)}
+        >
+          <p>
+            “{pendingDelete.name}” ekibi ve üyelikleri silinir. Bu ekibe bağlı kural grubu veya zamanlanmış inceleme
+            varsa silme reddedilir.
+          </p>
+        </ConfirmDialog>
+      )}
+    </div>
+  );
+}
+
+function TeamDialog({
+  team,
+  onClose,
+  onSaved,
+}: {
+  team: TeamItem | null;
+  onClose: () => void;
+  onSaved: (created: boolean) => void;
+}) {
+  const [name, setName] = useState(team?.name ?? '');
+  const [description, setDescription] = useState(team?.description ?? '');
+  const [dn, setDn] = useState(team?.ad_group_dn ?? '');
+  const [submitted, setSubmitted] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [failure, setFailure] = useState<string | null>(null);
+  const nameProblem = name.trim().length < 1 || name.trim().length > NAME_LIMIT ? `Ad 1-${NAME_LIMIT} karakter olmalıdır.` : null;
+  const dnProblem = /^\s*cn\s*=\s*\S/i.test(dn) && dn.trim().length <= DN_LIMIT ? null : 'DN, CN= ile başlamalıdır.';
+  const groupChanged = team !== null && dn.trim() !== team.ad_group_dn;
+
+  async function save() {
+    setSubmitted(true);
+    if (nameProblem || dnProblem) return;
+    setSaving(true);
+    setFailure(null);
+    try {
+      const body = {name, description, ad_group_dn: dn};
+      if (team) await TeamService.update(team.id, body);
+      else await TeamService.create(body);
+      onSaved(team === null);
+    } catch (error) {
+      setFailure(describeError(error));
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <Dialog
+      title={team ? 'Ekibi düzenle' : 'Yeni ekip'}
+      size="sm"
+      onClose={saving ? undefined : onClose}
+      busy={saving}
+      footer={
+        <>
+          <Button onClick={onClose} disabled={saving}>
+            Vazgeç
+          </Button>
+          <Button variant="primary" onClick={save} disabled={saving} busy={saving}>
+            Kaydet
+          </Button>
+        </>
+      }
+    >
+      <div className="stack">
+        {failure && <Alert tone="error">{failure}</Alert>}
+        <Field id="team-name" label="Ad" error={submitted ? nameProblem : null}>
+          <input
+            id="team-name"
+            className="input"
+            maxLength={NAME_LIMIT}
+            value={name}
+            onChange={(event) => setName(event.target.value)}
+          />
+        </Field>
+        <Field id="team-description" label="Açıklama (isteğe bağlı)">
+          <input
+            id="team-description"
+            className="input"
+            maxLength={500}
+            value={description}
+            onChange={(event) => setDescription(event.target.value)}
+          />
+        </Field>
+        <Field id="team-dn" label="AD grubu (DN)" hint={DN_NOTE} error={submitted ? dnProblem : null}>
+          <input
+            id="team-dn"
+            className="input mono"
+            maxLength={DN_LIMIT}
+            placeholder="CN=Grup,OU=Gruplar,DC=kurum,DC=local"
+            value={dn}
+            aria-describedby="team-dn-hint"
+            onChange={(event) => setDn(event.target.value)}
+          />
+        </Field>
+        {groupChanged && (
+          <Alert tone="warning">
+            AD grubu değişirse ekibin mevcut üyelikleri silinir; üyeler bir sonraki girişlerinde yeniden eşleşir.
+          </Alert>
+        )}
+      </div>
+    </Dialog>
+  );
+}
+
+function MembersDialog({team, onClose}: {team: TeamItem; onClose: () => void}) {
+  const members = useResource(`team-members:${team.id}`, (signal) => TeamService.members(team.id, signal));
+  return (
+    <Dialog title={`${team.name} — üyeler`} onClose={onClose} footer={<Button onClick={onClose}>Kapat</Button>}>
+      <div className="stack">
+        <p className="subtle">{MEMBERSHIP_NOTE}</p>
+        {members.status === 'error' && <ErrorState message={describeError(members.error)} onRetry={members.reload} />}
+        {members.status === 'loading' && members.data === undefined && <LoadingState label="Üyeler yükleniyor…" />}
+        {members.data &&
+          (members.data.items.length === 0 ? (
+            <EmptyState title="Bu ekibe henüz kimse eşleşmedi." />
+          ) : (
+            <div className="table-wrap">
+              <table className="table">
+                <thead>
+                  <tr>
+                    <th scope="col">Kişi</th>
+                    <th scope="col">Kullanıcı adı</th>
+                    <th scope="col">Eşleşme</th>
+                    <th scope="col">Son giriş</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {members.data.items.map((member) => (
+                    <tr key={member.username}>
+                      <td>{member.display_name}</td>
+                      <td className="mono">{member.username}</td>
+                      <td>{formatDateTime(member.synced_at)}</td>
+                      <td>{member.last_login_at ? formatDateTime(member.last_login_at) : '—'}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          ))}
+      </div>
+    </Dialog>
+  );
+}
