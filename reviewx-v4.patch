+        assert again.json()["critical"][0]["rule_group_ids"] == [performance["id"], security["id"]]
+        assert again.json()["draft_differs"] is False
+        frozen = await auth.client.get(
+            f"{auth.prefix}/rule-set/versions/{version['number']}",
