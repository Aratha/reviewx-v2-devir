# dwhcodereview backend development settings. Copy to .env; never commit .env.
DWHCODEREVIEW_ENVIRONMENT=development
DWHCODEREVIEW_DEBUG=true
DWHCODEREVIEW_LOG_LEVEL=INFO
DWHCODEREVIEW_PROJECT_NAME=dwhcodereview

DWHCODEREVIEW_API_PREFIX=/api/dwhcodereview/v1
DWHCODEREVIEW_TENANT_HEADER=x-tenant-id
DWHCODEREVIEW_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Required. Point it at a PostgreSQL you can reach from this machine and replace the placeholder
# password; this file is Git-ignored once copied to .env.
DWHCODEREVIEW_DATABASE_URL=postgresql+asyncpg://app:replace-with-a-local-password@localhost:5432/dwhcodereview_db

# DWHCODEREVIEW_JWT_PRIVATE_KEY holds the PEM signing key and never enters this file. For a host run,
# export the disposable local key from the project root:
#   export DWHCODEREVIEW_JWT_PRIVATE_KEY="$(sh scripts/dev-secrets.sh jwt-private-key)"
# Shared and deployed environments receive their own key only through backend.existingSecret.
DWHCODEREVIEW_JWT_ALGORITHM=ES256
DWHCODEREVIEW_JWT_ISSUER=dwhcodereview
DWHCODEREVIEW_JWT_AUDIENCE=dwhcodereview-api
DWHCODEREVIEW_ACCESS_TOKEN_EXPIRE_MINUTES=60

DWHCODEREVIEW_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
DWHCODEREVIEW_BOOTSTRAP_SUPER_ADMIN_USERNAME=super-admin
# Supply DWHCODEREVIEW_BOOTSTRAP_SUPER_ADMIN_PASSWORD only in the command process environment.
# Do not add the password to this file or version control.
