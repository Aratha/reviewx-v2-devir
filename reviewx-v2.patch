+"""Teams mapped to Active Directory groups, their memberships and their change history.
+
+application-foundation/PRDs/003-team-scoping owns these tables. A team is deleted physically
+together with its memberships (Requirement 6); the change history keeps the team's public
+identifier as text, so it outlives the team.
+"""
+
+from datetime import datetime
+from enum import StrEnum
+
+from sqlalchemy import (
+    BigInteger,
+    CheckConstraint,
+    DateTime,
+    ForeignKey,
+    Identity,
+    Index,
+    String,
+    Text,
+    func,
+    text,
+)
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.db.base_class import Base
+from app.domain.models.mixins import AuditSoftDeleteMixin, new_public_id
+from app.domain.team import (
+    TEAM_AD_GROUP_DN_MAX_LENGTH,
+    TEAM_DESCRIPTION_MAX_LENGTH,
+    TEAM_NAME_MAX_LENGTH,
+)
+
+
+class TeamChangeField(StrEnum):
+    """What a team history row records (team-scoping Güvenlik: DN changes are recorded)."""
+
+    CREATED = "created"
+    NAME = "name"
+    AD_GROUP_DN = "ad_group_dn"
+    DELETED = "deleted"
+
+
+class Team(AuditSoftDeleteMixin, Base):
+    __tablename__ = "app_team"
+    __table_args__ = (
+        Index("uq_app_team_tenant_name", "tenant_id", func.lower(text("name")), unique=True),
+        Index(
+            "uq_app_team_tenant_ad_group_dn",
+            "tenant_id",
+            func.lower(text("ad_group_dn")),
+            unique=True,
+        ),
+        Index(
+            "ix_app_team_active_tenant",
+            "tenant_id",
+            postgresql_where=text("is_deleted = false"),
+        ),
+        CheckConstraint(
+            f"char_length(name) BETWEEN 1 AND {TEAM_NAME_MAX_LENGTH}", name="name_length"
+        ),
+        CheckConstraint(
+            f"char_length(description) <= {TEAM_DESCRIPTION_MAX_LENGTH}",
+            name="description_length",
+        ),
+        CheckConstraint(
+            f"char_length(ad_group_dn) BETWEEN 4 AND {TEAM_AD_GROUP_DN_MAX_LENGTH} "
+            "AND lower(left(ad_group_dn, 3)) = 'cn='",
+            name="ad_group_dn_form",
+        ),
+        {
+            "comment": (
+                "A team of one tenant mapped to one Active Directory group (application-"
+                "foundation team-scoping). Members come only from the directory: every directory "
+                "login matches the user's own memberOf values to ad_group_dn. Managed by the "
+                "super admin; deleted physically with its memberships once nothing is bound to it."
+            )
+        },
+    )
+
+    team_id: Mapped[int] = mapped_column(BigInteger, Identity(), primary_key=True)
+    public_id: Mapped[str] = mapped_column(Text, default=new_public_id, nullable=False, unique=True)
+    tenant_id: Mapped[int] = mapped_column(
+        BigInteger,
+        ForeignKey("tenant.tenant_id", ondelete="RESTRICT"),
+        nullable=False,
+        comment="Owning tenant; references tenant.tenant_id.",
+    )
+    name: Mapped[str] = mapped_column(
+        String(TEAM_NAME_MAX_LENGTH),
+        nullable=False,
+        comment="Team name, 1-80 characters; unique in the tenant regardless of letter case.",
+    )
+    description: Mapped[str] = mapped_column(
+        String(TEAM_DESCRIPTION_MAX_LENGTH),
+        nullable=False,
+        default="",
+        server_default=text("''"),
+        comment="Optional explanation, at most 500 characters; empty when unset.",
+    )
+    ad_group_dn: Mapped[str] = mapped_column(
+        String(TEAM_AD_GROUP_DN_MAX_LENGTH),
+        nullable=False,
+        comment=(
+            "Distinguished name of the Active Directory group, normalized without spaces around "
+            "separators; one group maps to at most one team of the tenant regardless of letter "
+            "case. Not checked against the directory and never logged."
+        ),
+    )
+
+
+class TeamMember(AuditSoftDeleteMixin, Base):
+    __tablename__ = "app_team_member"
+    __table_args__ = (
+        Index(
+            "ix_app_team_member_active_user",
+            "user_id",
+            postgresql_where=text("is_deleted = false"),
+        ),
+        {
+            "comment": (
+                "Membership of a user in a team as matched at the user's last directory login "
+                "(team-scoping Requirement 2). Rewritten at every login; deleted with the team or "
+                "the user. There is no manual membership."
+            )
+        },
+    )
+
+    team_id: Mapped[int] = mapped_column(
+        BigInteger,
+        ForeignKey("app_team.team_id", ondelete="CASCADE"),
+        primary_key=True,
+        comment="Team; references app_team.team_id and is deleted with it.",
+    )
+    user_id: Mapped[int] = mapped_column(
+        BigInteger,
+        ForeignKey("app_user.user_id", ondelete="CASCADE"),
+        primary_key=True,
+        comment="Member; references app_user.user_id and is deleted with the user.",
+    )
+    synced_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        comment="UTC time of the directory login that last confirmed the membership.",
+    )
+
+
+class TeamChange(AuditSoftDeleteMixin, Base):
+    __tablename__ = "app_team_change"
+    __table_args__ = (
+        Index(
+            "ix_app_team_change_active_team",
+            "team_public_id",
+            "created_at",
+            postgresql_where=text("is_deleted = false"),
+        ),
+        CheckConstraint(
+            "changed_field IN ('created', 'name', 'ad_group_dn', 'deleted')",
+            name="changed_field_allowed",
+        ),
+        {
+            "comment": (
+                "Append-only history of team changes made by the super admin, written in the same "
+                "transaction as the change; an AD group change records who mapped which group "
+                "(team-scoping Güvenlik). The application only inserts rows. created_at is the "
+                "change time."
+            )
+        },
+    )
+
+    app_team_change_id: Mapped[int] = mapped_column(BigInteger, Identity(), primary_key=True)
+    tenant_id: Mapped[int] = mapped_column(
+        BigInteger,
+        ForeignKey("tenant.tenant_id", ondelete="RESTRICT"),
+        nullable=False,
+        index=True,
+        comment="Tenant in which the change happened; references tenant.tenant_id.",
+    )
+    actor_user_id: Mapped[int] = mapped_column(
+        BigInteger,
+        ForeignKey("app_user.user_id", ondelete="RESTRICT"),
+        nullable=False,
+        index=True,
+        comment="Super admin who made the change; references app_user.user_id.",
+    )
+    team_public_id: Mapped[str] = mapped_column(
+        Text,
+        nullable=False,
+        comment=(
+            "public_id of the changed team, kept as text so the history outlives a deleted team "
+            "(app_team.public_id)."
+        ),
+    )
+    changed_field: Mapped[str] = mapped_column(
+        String(16),
+        nullable=False,
+        comment=(
+            "Code reflection app.domain.models.team.TeamChangeField: 'created', 'name', "
+            "'ad_group_dn' or 'deleted'."
+        ),
+    )
+    old_value: Mapped[str | None] = mapped_column(
+        String(TEAM_AD_GROUP_DN_MAX_LENGTH),
+        nullable=True,
+        comment="Value before the change (team name or AD group DN); empty for 'created'.",
+    )
+    new_value: Mapped[str | None] = mapped_column(
+        String(TEAM_AD_GROUP_DN_MAX_LENGTH),
+        nullable=True,
+        comment="Value after the change in the same encoding; empty for 'deleted'.",
+    )
