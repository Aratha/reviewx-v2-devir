+      await RuleProposalService.create({
+        kind: 'rule',
+        summary,
+        text,
+        priority,
+        requires_metadata: metadata,
+        rule_group_ids: groups,
+        group_name: '',
+        group_description: '',
+        rule_codes: [],
+        rationale,
+      });
+      onSent();
