+    ).status_code == 200
+
+    approved = await proposals.call(
+        "POST", f"/rule-set/publish-requests/{request['id']}/approve", admin
+    )
+
+    assert approved.status_code == 409
+    assert approved.json()["detail"]["code"] == "publish_request_stale"
+
