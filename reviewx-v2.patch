diff --git a/app/frontend/src/pages/TeamsPage.tsx b/app/frontend/src/pages/TeamsPage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b664a67ac0a9e8395d1b380c2cbb891d22b6af20
