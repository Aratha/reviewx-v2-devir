ARG PYTHON_BASE_IMAGE=registry.internal.invalid/platform/python:3.13-alpine3.23@sha256:7ea3f82de8ea6d4fb7e5d2bbe3fe3c9d931700b7a529f1fe5769e42abe514ca1
FROM ${PYTHON_BASE_IMAGE}

ARG APP_GID=10001
ARG APP_UID=10001
ARG DEPENDENCY_MODE=offline

ENV HOME=/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/app/backend \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

RUN addgroup -g "${APP_GID}" app \
    && adduser -D -H -u "${APP_UID}" -G app app

WORKDIR /workspace/app/backend
COPY app/backend/requirements.txt /tmp/dependencies/requirements.txt
RUN --mount=type=bind,from=python_wheelhouse,source=/,target=/opt/wheelhouse \
    --mount=type=secret,id=pip_conf,target=/etc/pip.conf,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) python -m pip install --no-cache-dir -r /tmp/dependencies/requirements.txt ;; \
        offline) PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 python -m pip install \
            --no-cache-dir --no-index --find-links=/opt/wheelhouse \
            -r /tmp/dependencies/requirements.txt ;; \
        *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
    esac; \
    rm -rf /tmp/dependencies

COPY --chown=${APP_UID}:${APP_GID} app/backend/app ./app
COPY --chown=${APP_UID}:${APP_GID} app/backend/alembic.ini ./alembic.ini
COPY --chown=${APP_UID}:${APP_GID} schema /workspace/schema

USER ${APP_UID}:${APP_GID}
ENTRYPOINT ["alembic", "upgrade", "head"]
