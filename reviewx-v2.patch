+"""Team management contracts (application-foundation/PRDs/003-team-scoping API contract).
+
+Lengths here are transport bounds only; the service applies the product limits with their own
+error codes (team_name_invalid, team_name_duplicate, team_ad_group_invalid,
+team_ad_group_duplicate).
+"""
+
+from datetime import datetime
+
+from pydantic import BaseModel, Field
+
+_TRANSPORT_TEXT_MAX_LENGTH = 2_000
+
+
+class TeamWrite(BaseModel):
+    name: str = Field(max_length=_TRANSPORT_TEXT_MAX_LENGTH)
